extends Control

#总节点操作众多子节点的方法用通知，子节点操作总节点的方法直接引用
signal 通知_商品显示渲染
signal 通知_玩家属性渲染
signal 通知_确认生成商店界面
signal 通知_确认生成奖励界面

@export var 界面模式扩展 : int = 1  #生成时被指定：1-商店界面，2-奖励界面

var 选择模式 : int = 1  #1-选择商品，2-选择继续，3-选择刷新
var 选择栏位数 : int = 1
var 已刷新次数 : int = 0
var 已免费刷新次数 : int = 0
var 已付费刷新次数 : int = 0
var 剩余免费刷新次数 : int = 0
var 当前刷新价格 : int = 0
var 商店最多出现技能数 : int = 2
var 技能出现概率 : float
var 当前奖励金钱数 : float = 0

var 商品栏位数最大 : int = 4

var 道具数据库 : Dictionary
var 当前角色名称 : String
var 当前角色技能数据库 : Dictionary

var 黑幕图片 : ColorRect = null

var 商品类型字典 : Dictionary  #1-道具，2-技能
var 商品编号字典 : Dictionary
var 商品数量字典 : Dictionary
var 商品价格字典 : Dictionary
var 商品等级概率数 : Dictionary
var 商品等级概率数总和 : float

var 道具抽取字典 : Dictionary  #key为等级数值，属性值为编号列表
var 技能抽取字典 : Dictionary
var 缓存限定道具数据 : Dictionary = {}  #比如某个道具限定3，已拥有2，栏位1抽到了，那么应该记录缓存数量1，1+2>=3，接下来的栏位不应该再出现这个道具
var 缓存限定技能数据 : Dictionary = {}  #比如在栏位1抽到了-999耐久(无限)的技能，那么接下来的栏位不应该再出现这个技能

func _ready() -> void:
	道具数据库 = 全局数据库.道具数据库
	当前角色名称 = 全局数据库.角色数据库[全局数据_周期对局.当前角色编号]["角色名称"]
	var 拼接技能数据库键名 = "技能数据库_" + 当前角色名称
	当前角色技能数据库 = 全局数据库.技能数据库[拼接技能数据库键名]
	黑幕图片 = self.get_node("黑幕图片")
	道具数据库 = 全局数据库.道具数据库
	
	match 界面模式扩展:
		1:
			黑幕图片.visible = false
			通知_确认生成商店界面.emit()
			全局方法.商店相关属性更新.connect(商店相关属性更新)
		2:
			self.process_mode = Node.PROCESS_MODE_ALWAYS
			get_tree().paused = true
			全局数据_系统.奖励界面已打开 = true
			全局数据_系统.是否禁用打开菜单界面 = true
			全局数据_系统.角色输入许可 = false
			self.z_index = 3  #仅当是奖励界面时才上调显示优先级
			黑幕图片.visible = true
			通知_确认生成奖励界面.emit()
	
	填充抽取字典()
	生成时数据同步()
	抽取全部商品()
	
	通知_商品显示渲染.emit()
	通知_玩家属性渲染.emit()

func _input(输入事件: InputEvent) -> void:
	if 全局数据_系统.UI输入许可:
		match 选择模式:
			1:
				if 输入事件.is_action_pressed("操作→") and 选择栏位数 < 商品栏位数最大:
					选择栏位数 += 1
					切换查看商品栏位()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作←") and 选择栏位数 > 1:
					选择栏位数 -= 1
					切换查看商品栏位()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作↓"):
					切换查看继续选项()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作确认"):
					确认查看商品栏位()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作取消"):
					刷新抽取商品()
					全局方法.UI输入倒计时启动()
			2:
				if 输入事件.is_action_pressed("操作确认"):
					确认查看继续选项()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作取消"):
					刷新抽取商品()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作↑"):
					取消查看继续选项()
					全局方法.UI输入倒计时启动()
			3:
				if 输入事件.is_action_pressed("操作确认"):
					刷新抽取商品()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作取消"):
					刷新抽取商品()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作↑"):
					切换查看商品栏位()
					全局方法.UI输入倒计时启动()

func 生成时数据同步() -> void:  #同步波次数据或奖励数据
	var 当前波次数据 : Dictionary
	if 全局数据库.波次数据库.has(全局数据_周期对局.当前波次):
		当前波次数据 = 全局数据库.波次数据库[全局数据_周期对局.当前波次]
	else:
		var 数据库中最大波次 = 全局数据库.波次数据库.keys().max()
		当前波次数据 = 全局数据库.波次数据库[数据库中最大波次]
	match 界面模式扩展:
		1:
			商品等级概率数总和 = 全局方法.构建概率数字典(商品等级概率数, "当前概率数_物品等级", 当前波次数据)
			剩余免费刷新次数 = int(全局数据_周期对局.额外属性_商店免费刷新次数)
		2:
			var 等级奖励数据库 = 全局数据库.等级奖励数据库
			var 当前奖励对应等级 = 全局数据_周期对局.玩家属性_等级 - 全局数据_周期波次.记录升级次数 + 1
			var 遍历键 = 等级奖励数据库.size()
			var 当前奖励数据 : Dictionary
			while true:
				var 遍历等级周期 = 等级奖励数据库[遍历键]["等级周期"]
				if int(当前奖励对应等级) % 遍历等级周期 == 0:
					当前奖励数据 = 等级奖励数据库[遍历键]
					break
				遍历键 -= 1
			当前奖励金钱数 = 等级奖励数据库[遍历键]["金币奖励"]
			商品等级概率数总和 = 全局方法.构建概率数字典(商品等级概率数, "当前概率数_物品等级", 当前奖励数据)
	技能出现概率 = 当前波次数据["技能出现概率"]
	当前刷新价格计算()

func 填充抽取字典() -> void:
	var 道具数据库_道具等级次级索引 = 全局数据库.道具数据库_道具等级次级索引
	var 拼接技能数据库键名 = "技能数据库_" + 当前角色名称
	var 技能数据库_技能等级次级索引 = 全局数据库.技能数据库_技能等级次级索引[拼接技能数据库键名]
	var 该角色解锁道具列表 = 全局数据库.道具数据库_解锁角色次级索引.get(全局数据_周期对局.当前角色编号, {})
	var 该角色白名单道具列表 = 全局数据库.道具数据库_白名单角色次级索引.get(全局数据_周期对局.当前角色编号, {})
	var 该角色黑名单道具列表 = 全局数据库.道具数据库_黑名单角色次级索引.get(全局数据_周期对局.当前角色编号, {})
	for 遍历等级 in 道具数据库_道具等级次级索引:
		道具抽取字典[遍历等级] = []
		for 遍历编号 in 道具数据库_道具等级次级索引[遍历等级]:
			var 遍历道具数据 = 道具数据库[遍历编号]
			match 遍历道具数据["道具抽取类型"]:
				"不可抽取":
					continue
				"解锁":
					if not 遍历编号 in 该角色解锁道具列表 and not 遍历编号 in 全局数据_游玩进度.道具解锁数据:
						continue
				"白名单":
					if not 遍历编号 in 该角色白名单道具列表:
						continue
				"黑名单":
					if 遍历编号 in 该角色黑名单道具列表:
						continue
			道具抽取字典[遍历等级].append(遍历编号)
	
	for 遍历等级 in 技能数据库_技能等级次级索引:
		技能抽取字典[遍历等级] = []
		for 遍历编号 in 技能数据库_技能等级次级索引[遍历等级]:
			var 遍历技能数据 = 当前角色技能数据库[遍历编号]
			match 遍历技能数据["技能抽取类型"]:
				"不可抽取":
					continue
			技能抽取字典[遍历等级].append(遍历编号)

func 刷新抽取商品() -> void:
	if 剩余免费刷新次数 > 0:
		剩余免费刷新次数 -= 1
		已免费刷新次数 += 1
	elif 全局数据_周期对局.金钱数 >= 当前刷新价格:
		全局数据_周期对局.金钱数 -= 当前刷新价格
		已付费刷新次数 += 1
	else:
		return
	已刷新次数 += 1
	当前刷新价格计算()
	抽取全部商品()
	通知_商品显示渲染.emit()
	通知_玩家属性渲染.emit()

func 当前刷新价格计算() -> void:
	if 剩余免费刷新次数 > 0:
		当前刷新价格 = 0
	else:
		当前刷新价格 = (全局数据_周期对局.当前波次 + 已付费刷新次数 * round(sqrt(全局数据_周期对局.当前波次))) * 全局数据_周期对局.额外属性_商店刷新价格倍率

func 抽取全部商品() -> void:
	缓存限定道具数据 = {}
	缓存限定技能数据 = {}
	var 已出现技能商品数量 : int = 0
	for 遍历栏位数 in range(1, 商品栏位数最大 + 1):
		var 随机数 = randf()
		if 随机数 <= 技能出现概率 and 已出现技能商品数量 < 商店最多出现技能数:
			已出现技能商品数量 += 1
			抽取单个商品(遍历栏位数, 2)
		else:
			抽取单个商品(遍历栏位数, 1)
	接口_抽取全部商品时()

func 抽取单个商品(栏位数 : int, 物品类型 : int = -1, 物品等级 : int = -1) -> void:
	if 物品类型 == -1:
		var 随机数 = randf()
		if 随机数 <= 技能出现概率:
			抽取单个商品(栏位数, 2, 物品等级)
		else:
			抽取单个商品(栏位数, 1, 物品等级)
		return
	var 生成等级随机数 = randf_range(0, 商品等级概率数总和)
	var 决定等级 : int
	if 物品等级 == -1:
		for 遍历等级 in range(1, 商品等级概率数.size() + 1):
			if 生成等级随机数 <= 商品等级概率数[遍历等级]:
				决定等级 = 遍历等级
				break
			生成等级随机数 -= 商品等级概率数[遍历等级]
		var 幸运属性值 = 全局数据_周期对局.玩家属性_幸运
		if 幸运属性值 > 0 and 决定等级 < 商品等级概率数.size():
			var 幸运每阶段值 = 全局数据_环境.幸运每阶段值
			var 幸运每阶段升级概率 = 全局数据_环境.幸运每阶段升级概率
			while 幸运属性值 > 0:
				var 本阶段幸运属性值 = min(幸运每阶段值, 幸运属性值)
				var 本阶段升级概率值 = 本阶段幸运属性值 / 幸运每阶段值 * 幸运每阶段升级概率
				var 随机数 = randf()
				if 随机数 <= 本阶段升级概率值:
					决定等级 += 1
					幸运属性值 -= 幸运每阶段值
					if 决定等级 >= 商品等级概率数.size():
						break
				else:
					break
	else:
		决定等级 = 物品等级
	var 物品编号 : int
	var 物品数量 : int
	var 物品价格 : int
	match 物品类型:
		1:
			var 临时抽取列表 = 道具抽取字典[决定等级].duplicate()
			while true:
				var 随机索引 = randi_range(0, 临时抽取列表.size() - 1)
				物品编号 = 临时抽取列表[随机索引]
				var 该道具数据 = 道具数据库[物品编号]
				var 该道具限定数量 = float(该道具数据["道具限定数量"])
				var 该道具持有数量 = 全局数据_周期对局.道具持有数据.get(物品编号, 0)
				var 该道具缓存数量 = 缓存限定道具数据.get(物品编号, 0)
				if 该道具限定数量 == 0 or 该道具持有数量 + 该道具缓存数量 < 该道具限定数量:
					break
				else:
					临时抽取列表.remove_at(随机索引)
			物品数量 = 1
			缓存限定道具数据[物品编号] = 缓存限定道具数据.get(物品编号, 0) + 物品数量
			物品价格 = 道具数据库[物品编号]["道具价格"] * 全局数据_周期对局.额外属性_商店物品价格倍率
			if 界面模式扩展 == 2:
				物品价格 = 0
		2:
			if not 决定等级 in 技能抽取字典:
				抽取单个商品(栏位数, 1, 决定等级)
				return
			var 临时抽取列表 = 技能抽取字典[决定等级].duplicate()
			while true:
				if 临时抽取列表.size() <= 0:
					抽取单个商品(栏位数, 1, 决定等级)
					return
				var 随机索引 = randi_range(0, 临时抽取列表.size() - 1)
				物品编号 = 临时抽取列表[随机索引]
				var 该技能持有数量 = 全局数据_周期对局.技能持有数据.get(物品编号, 0)
				var 该技能缓存数量 = 缓存限定技能数据.get(物品编号, 0)
				if 该技能持有数量 == -999 or 该技能缓存数量 == -999:
					临时抽取列表.remove_at(随机索引)
				else:
					break
			物品数量 = randi_range(当前角色技能数据库[物品编号]["抽取最小耐久度"], 当前角色技能数据库[物品编号]["抽取最大耐久度"])
			if 物品数量 == -999:
				缓存限定技能数据[物品编号] = -999
			物品价格 = (当前角色技能数据库[物品编号]["技能基础价格"] + 物品数量 * 当前角色技能数据库[物品编号]["技能耐久度递增价格"]) * 全局数据_周期对局.额外属性_商店物品价格倍率
			if 界面模式扩展 == 2:
				物品数量 = 2
				物品价格 = 0
	商品类型字典[栏位数] = 物品类型
	商品编号字典[栏位数] = 物品编号
	商品数量字典[栏位数] = 物品数量
	商品价格字典[栏位数] = 物品价格

func 商店相关属性更新() -> void:
	剩余免费刷新次数 = int(全局数据_周期对局.额外属性_商店免费刷新次数) - 已免费刷新次数
	当前刷新价格计算()
	通知_商品显示渲染.emit()
	通知_玩家属性渲染.emit()

func 切换查看商品栏位() -> void:
	选择模式 = 1
	通知_商品显示渲染.emit()

func 切换查看继续选项() -> void:
	选择模式 = 2
	通知_商品显示渲染.emit()

func 切换查看刷新选项() -> void:
	选择模式 = 3
	通知_商品显示渲染.emit()


func 确认查看商品栏位() -> void:
	var 商品类型 = 商品类型字典.get(选择栏位数, 0)
	if 商品类型 == 0:
		return
	var 商品价格 = 商品价格字典.get(选择栏位数, 0)
	if 全局数据_周期对局.金钱数 >= 商品价格 or 商品价格 <= 0:
		全局数据_周期对局.金钱数 -= 商品价格字典.get(选择栏位数, 0)
		var 商品编号 = 商品编号字典[选择栏位数]
		var 商品数量 = 商品数量字典[选择栏位数]
		全局方法.物品获得处理(商品编号, 商品类型, 商品数量)
		全局方法.播放音频("基础音效_按键声")
		match 界面模式扩展:
			1:
				商品类型字典[选择栏位数] = 0
				商品价格字典[选择栏位数] = 0
				商品编号字典[选择栏位数] = 0
				商品数量字典[选择栏位数] = 0
			2:
				全局数据_周期波次.记录升级次数 -= 1
				奖励界面刷新()
		
		通知_商品显示渲染.emit()
		通知_玩家属性渲染.emit()

func 确认查看继续选项() -> void:
	match 界面模式扩展:
		1:
			全局方法.播放音频("基础音效_按键声")
			全局方法.切换场景("技能装配界面场景")
		2:
			全局方法.播放音频("基础音效_按键声")
			全局数据_周期波次.记录升级次数 -= 1
			全局数据_周期对局.金钱数 += 当前奖励金钱数
			奖励界面刷新()
	
	通知_商品显示渲染.emit()
	通知_玩家属性渲染.emit()

func 确认查看刷新选项() -> void:
	刷新抽取商品()
	通知_商品显示渲染.emit()
	通知_玩家属性渲染.emit()


func 取消查看继续选项() -> void:
	选择模式 = 1
	通知_商品显示渲染.emit()

func 取消查看刷新选项() -> void:
	选择模式 = 1
	通知_商品显示渲染.emit()


func 接口_抽取全部商品时() -> void:
	if 76 in 全局数据_周期对局.道具持有数据:
		if 已刷新次数 == 0:
			商品类型字典[1] = 1
			商品编号字典[1] = 40
			商品数量字典[1] = 1
			商品价格字典[1] = 道具数据库[40]["道具价格"] * 全局数据_周期对局.额外属性_商店物品价格倍率

func 奖励界面刷新() -> void:
	if 全局数据_周期波次.记录升级次数 > 0:
		已刷新次数 = 0
		已付费刷新次数 = 0
		生成时数据同步()
