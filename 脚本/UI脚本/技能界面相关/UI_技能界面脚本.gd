extends Control

#总节点操作众多子节点的方法用通知，子节点操作总节点的方法直接引用
signal 通知_技能显示渲染
signal 通知_玩家属性渲染
signal 通知_继续下一波选项删除

@export var 界面模式扩展 : int = 1  #生成时被指定：1-技能界面，2-技能装配界面

var 选择模式 : int = 1  #1-选择技能键位中，2-选择技能中，3-选择继续下一波（技能装配界面）
var 当前角色技能背包类型 : int = 1

var 键位栏位数最大 : int = 4  #指的是键位的显示栏位数
var 键位背包栏位页数最大 : int = 3  #指的是当前键位背包的显示栏位数
var 键位背包栏位行数最大 : int = 3
var 滑动条最小长度 : int = 60
var 滑动条最大移动距离 : int = 238

var 当前技能界面光标移动逻辑 : Dictionary
var 当前角色名称 : String
var 当前角色技能数据库 : Dictionary
var 当前角色技能数据库_技能键位次级索引 : Dictionary

var 当前键位背包技能编号列表 : PackedInt32Array #索引0略过，从索引1开始，临时构造的背包都用数组，节省性能
var 当前键位背包技能数量 : int 

var 黑幕图片 : ColorRect = null

func _ready() -> void:
	当前角色名称 = 全局数据库.角色数据库[全局数据_周期对局.当前角色编号]["角色名称"]
	当前角色技能背包类型 = 全局数据库.角色数据库[全局数据_周期对局.当前角色编号]["角色技能背包类型"]
	var 拼接技能数据库键名 = "技能数据库_" + 当前角色名称
	当前角色技能数据库 = 全局数据库.技能数据库[拼接技能数据库键名]
	当前角色技能数据库_技能键位次级索引 = 全局数据库.技能数据库_技能键位次级索引[拼接技能数据库键名]
	黑幕图片 = self.get_node("黑幕图片")
	
	if 当前角色技能背包类型 == 1 or 当前角色技能背包类型 == 2:
		当前技能界面光标移动逻辑 = 全局数据库.技能界面光标移动逻辑数据库["技能界面光标移动逻辑1"]
		self.get_node("分类节点3").queue_free()
		键位栏位数最大 = 4
		键位背包栏位页数最大 = 3
		键位背包栏位行数最大 = 3
		滑动条最小长度 = 60
		滑动条最大移动距离 = 238
	elif 当前角色技能背包类型 == 3:
		当前技能界面光标移动逻辑 = 全局数据库.技能界面光标移动逻辑数据库["技能界面光标移动逻辑3"]
		self.get_node("分类节点1").queue_free()
		键位栏位数最大 = 6
		键位背包栏位页数最大 = 3
		键位背包栏位行数最大 = 3
		滑动条最小长度 = 60
		滑动条最大移动距离 = 238
	
	if 全局数据_系统.当前查看技能栏位数 > 全局数据_周期对局.技能背包总栏数:
		全局数据_系统.当前查看技能栏位数 = 1
	if 全局数据_系统.当前查看技能键位组合 > 键位栏位数最大:
		全局数据_系统.当前查看技能键位组合 = 1
	
	match 界面模式扩展:
		1:
			self.process_mode = Node.PROCESS_MODE_ALWAYS
			get_tree().paused = true
			通知_继续下一波选项删除.emit()
			全局数据_系统.角色输入许可 = false
			全局数据_系统.背包界面已打开 = true
			黑幕图片.visible = true
			self.z_index = 4  #仅当是技能界面时才上调显示优先级
		2:
			黑幕图片.visible = false
	
	构造当前键位背包技能编号列表()
	通知_技能显示渲染.emit()
	通知_玩家属性渲染.emit()

func _input(输入事件: InputEvent) -> void:
	if 全局数据_系统.UI输入许可:
		match 选择模式:
			1:
				var 此时移动逻辑 = 当前技能界面光标移动逻辑[全局数据_系统.当前查看技能键位组合]
				if 输入事件.is_action_pressed("操作←") and str(此时移动逻辑["此时向左移动"]) != "":
					全局数据_系统.当前查看技能键位组合 = 此时移动逻辑["此时向左移动"]
					切换查看键位()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作↑") and str(此时移动逻辑["此时向上移动"]) != "":
					全局数据_系统.当前查看技能键位组合 = 此时移动逻辑["此时向上移动"]
					切换查看键位()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作→"):
					if str(此时移动逻辑["此时向右移动"]) != "":
						全局数据_系统.当前查看技能键位组合 = 此时移动逻辑["此时向右移动"]
						切换查看键位()
						全局方法.UI输入倒计时启动()
					elif 界面模式扩展 == 2:
						选择模式 = 3
						切换查看继续下一波按钮()
						全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作↓"):
					if str(此时移动逻辑["此时向下移动"]) != "":
						全局数据_系统.当前查看技能键位组合 = 此时移动逻辑["此时向下移动"]
						切换查看键位()
						全局方法.UI输入倒计时启动()
					elif 界面模式扩展 == 2:
						选择模式 = 3
						切换查看继续下一波按钮()
						全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作确认"):
					确认查看键位()
					全局方法.UI输入倒计时启动()
			2:
				if 输入事件.is_action_pressed("操作→") and 全局数据_系统.当前查看技能栏位数 < 当前键位背包技能数量:
					全局数据_系统.当前查看技能栏位数 += 1
					切换查看当前键位背包()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作←") and 全局数据_系统.当前查看技能栏位数 > 1:
					全局数据_系统.当前查看技能栏位数 -= 1
					切换查看当前键位背包()
					全局方法.UI输入倒计时启动()
				elif ((输入事件.is_action_pressed("操作↓") or 输入事件.is_action_pressed("鼠标滚轮↓")) and 
				全局数据_系统.当前查看技能栏位数 < 当前键位背包技能数量):
					全局数据_系统.当前查看技能栏位数 += 键位背包栏位行数最大
					if 全局数据_系统.当前查看技能栏位数 > 当前键位背包技能数量:
						全局数据_系统.当前查看技能栏位数 = 当前键位背包技能数量
					切换查看当前键位背包()
					全局方法.UI输入倒计时启动()
				elif ((输入事件.is_action_pressed("操作↑") or 输入事件.is_action_pressed("鼠标滚轮↑")) and
				 全局数据_系统.当前查看技能栏位数 > 1):
					全局数据_系统.当前查看技能栏位数 -= 键位背包栏位行数最大
					if 全局数据_系统.当前查看技能栏位数 < 1:
						全局数据_系统.当前查看技能栏位数 = 1
					切换查看当前键位背包()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作确认"):
					确认查看当前键位背包()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作取消"):
					取消查看当前键位背包()
					全局方法.UI输入倒计时启动()
			3:
				if 输入事件.is_action_pressed("操作确认"):
					确认查看继续下一波按钮()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作取消") or 输入事件.is_action_pressed("操作↑") or 输入事件.is_action_pressed("操作←"):
					选择模式 = 1
					取消查看继续下一波按钮()
					全局方法.UI输入倒计时启动()
		if 输入事件.is_action_pressed("菜单1"):
			match 界面模式扩展:
				1:
					关闭技能界面()
					全局方法.UI输入倒计时启动()
				2:
					if 全局数据_周期对局.当前对局进行中 == 0:
						退出到角色选择界面()
		elif 输入事件.is_action_pressed("菜单2"):
			match 界面模式扩展:
				1:
					打开背包界面()
					全局方法.UI输入倒计时启动()

func 构造当前键位背包技能编号列表() -> void:
	当前键位背包技能编号列表 = [0]  #提前将0填入第一个索引进行占位，保证实用索引是从1开始的
	var 技能持有编号列表 = 全局数据_周期对局.技能持有数据.keys()
	var 当前技能过滤数据库 = []
	if 当前角色技能数据库_技能键位次级索引.has(全局数据_系统.当前查看技能键位组合):
		当前技能过滤数据库 = 当前角色技能数据库_技能键位次级索引[全局数据_系统.当前查看技能键位组合]
	for 遍历 in 技能持有编号列表:
		if 遍历 in 当前技能过滤数据库:
			当前键位背包技能编号列表.append(遍历)
	当前键位背包技能数量 = 当前键位背包技能编号列表.size() - 1

func 切换查看键位() -> void:
	构造当前键位背包技能编号列表()
	全局数据_系统.当前查看技能栏位数 = 1
	var 当前查看技能编号 = 全局数据_周期对局.技能编号_键位[全局数据_系统.当前查看技能键位组合]
	if 当前查看技能编号 > 0:
		全局数据_系统.当前查看技能栏位数 = 当前键位背包技能编号列表.find(当前查看技能编号)
	选择模式 = 1
	通知_技能显示渲染.emit()

func 切换查看当前键位背包() -> void:
	选择模式 = 2
	通知_技能显示渲染.emit()

func 切换查看继续下一波按钮() -> void:
	选择模式 = 3
	通知_技能显示渲染.emit()

func 取消查看当前键位背包() -> void:
	选择模式 = 1
	通知_技能显示渲染.emit()

func 取消查看继续下一波按钮() -> void:
	选择模式 = 1
	通知_技能显示渲染.emit()

func 确认查看键位() -> void:
	选择模式 = 2
	通知_技能显示渲染.emit()

func 确认查看当前键位背包() -> void:
	#只有在技能装配界面，并且不是卡组技能类型的情况下，才允许按下键位背包的图标，从而装配技能
	if 界面模式扩展 == 2 and 当前角色技能背包类型 != 2:
		if 全局数据_系统.当前查看技能栏位数 <= 当前键位背包技能数量:
			var 当前查看技能编号 = 当前键位背包技能编号列表[全局数据_系统.当前查看技能栏位数]
			var 当前查看技能数量 = 全局数据_周期对局.技能持有数据[当前查看技能编号]
			if 当前查看技能数量 > 0 or 当前查看技能数量 == -999:
				if 全局数据_周期对局.技能编号_键位[全局数据_系统.当前查看技能键位组合] == 当前查看技能编号:
					if 当前查看技能数量 != -999:
						全局数据_周期对局.技能编号_键位[全局数据_系统.当前查看技能键位组合] = 0
				else:
					全局数据_周期对局.技能编号_键位[全局数据_系统.当前查看技能键位组合] = 当前查看技能编号
				选择模式 = 1
				通知_技能显示渲染.emit()

func 确认查看继续下一波按钮() -> void:
	全局方法.开始下一波次()

func 关闭技能界面() -> void:
	全局数据_系统.背包界面已打开 = false
	全局方法.UI输入倒计时启动()
	if 全局数据_系统.奖励界面已打开 == false:
		get_tree().paused = false
	self.queue_free()

func 打开背包界面() -> void:
	if not 全局数据_系统.是否禁用打开背包界面:
		全局方法.打开背包界面()
		self.queue_free()

func 退出到角色选择界面() -> void:
	全局方法.切换场景("角色选择界面场景")
