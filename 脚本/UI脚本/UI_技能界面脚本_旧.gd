extends Control

#虽然不同的技能界面和技能装配界面是不同的tscn对象，但都是用同一个gd脚本
@export var 选择模式 : int = 1  #1-选择技能键位中，2-选择技能中，3-选择继续下一波（技能装配界面）
@export var 滑动条最小长度 : int = 60
@export var 滑动条最大移动距离 : int = 238
@export var 当前角色技能背包类型 : int = 1
@export var 键位栏位数最大 : int = 4  #指的是键位的显示栏位数
@export var 键位背包栏位页数最大 : int = 3  #指的是当前键位背包的显示栏位数
@export var 键位背包栏位行数最大 : int = 3
@export var 界面模式扩展 : int = 1  #1-技能界面，2-技能装配界面

var 当前技能界面光标移动逻辑 : Dictionary
var 当前角色名称 : String
var 当前角色技能数据库 : Dictionary
var 当前角色技能数据库_技能键位次级索引 : Dictionary
var 当前键位背包技能编号列表 : Array #索引0略过，从索引1开始
var 当前键位背包技能数量 : int

var UI内容节点 = null
var 黑幕图片 = null
var 主要图片节点 = null
var 选中指示图片 = null
var 当前技能等级框显示 = null
var 当前技能图标显示 = null
var 当前技能名称显示 = null
var 当前技能描述显示 = null
var 玩家属性名称显示 = null
var 玩家属性数值显示 = null

var 键位上技能等级框显示集合 = null
var 键位上技能图标显示集合 = null
var 键位上技能等级框显示列表 : Array
var 键位上技能图标显示列表 : Array

var 当前键位技能等级框显示集合 = null
var 当前键位技能图标显示集合 = null
var 当前键位技能等级框显示列表 : Array
var 当前键位技能图标显示列表 : Array
var 当前键位展示框黑幕显示集合 = null
var 当前键位展示框黑幕显示列表 : Array

var 键位上技能图标区域集合 = null
var 键位上技能图标区域列表 : Array
var 当前键位技能图标区域集合 = null
var 当前键位技能图标区域列表 : Array
var 技能装配界面选项区域集合 = null
var 技能装配界面选项区域列表 : Array

var 当前键位技能数量显示集合 = null
var 当前键位技能数量显示列表 : Array
var 键位上技能数量显示集合 = null
var 键位上技能数量显示列表 : Array
var 技能装配界面选项文本显示集合 = null
var 技能装配界面选项文本显示列表 : Array

var 滑动条图片显示 = null
var 滑动条起始连接点 = null

func _ready() -> void:
	当前角色名称 = 全局数据库.角色数据库[全局数据_周期对局.当前角色编号]["角色名称"]
	var 拼接技能数据库键名 = "技能数据库_" + 当前角色名称
	当前角色技能数据库 = 全局数据库.技能数据库[拼接技能数据库键名]
	当前角色技能数据库_技能键位次级索引 = 全局数据库.技能数据库_技能键位次级索引[拼接技能数据库键名]
	
	if 当前角色技能背包类型 == 2:
		选择模式 = 2
	else:
		var 拼接技能界面光标移动逻辑字符串 = "技能界面光标移动逻辑%d" % 当前角色技能背包类型
		当前技能界面光标移动逻辑 = 全局数据库.技能界面光标移动逻辑数据库[拼接技能界面光标移动逻辑字符串]
	
	UI内容节点 = self.get_node("UI内容节点")
	黑幕图片 = self.get_node("黑幕图片")
	主要图片节点 = UI内容节点.get_node("图片")
	选中指示图片 = UI内容节点.get_node("选中指示图片")
	当前技能等级框显示 = UI内容节点.get_node("当前技能等级框显示")
	当前技能图标显示 = UI内容节点.get_node("当前技能图标显示")
	当前技能名称显示 = self.get_node("当前技能名称显示")
	当前技能描述显示 = self.get_node("当前技能描述显示")
	玩家属性名称显示 = self.get_node("玩家属性名称显示")
	玩家属性数值显示 = self.get_node("玩家属性数值显示")
	
	键位上技能等级框显示集合 = UI内容节点.get_node("键位上技能等级框显示集合")
	键位上技能图标显示集合 = UI内容节点.get_node("键位上技能图标显示集合")
	全局方法.填充节点列表(键位上技能等级框显示列表, 1, 键位栏位数最大, 键位上技能等级框显示集合, "键位上技能等级框显示")
	全局方法.填充节点列表(键位上技能图标显示列表, 1, 键位栏位数最大, 键位上技能图标显示集合, "键位上技能图标显示")
	
	当前键位技能等级框显示集合 = UI内容节点.get_node("当前键位技能等级框显示集合")
	当前键位技能图标显示集合 = UI内容节点.get_node("当前键位技能图标显示集合")
	全局方法.填充节点列表(当前键位技能等级框显示列表, 1, 键位背包栏位页数最大, 当前键位技能等级框显示集合, "当前键位技能等级框显示")
	全局方法.填充节点列表(当前键位技能图标显示列表, 1, 键位背包栏位页数最大, 当前键位技能图标显示集合, "当前键位技能图标显示")
	当前键位展示框黑幕显示集合 = UI内容节点.get_node("当前键位展示框黑幕显示集合")
	全局方法.填充节点列表(当前键位展示框黑幕显示列表, 1, 键位背包栏位页数最大, 当前键位展示框黑幕显示集合, "当前键位展示框黑幕显示")
	
	键位上技能数量显示集合 = self.get_node("键位上技能数量显示集合")
	全局方法.填充节点列表(键位上技能数量显示列表, 1, 键位栏位数最大, 键位上技能数量显示集合, "键位上技能数量显示")
	当前键位技能数量显示集合 = self.get_node("当前键位技能数量显示集合")
	全局方法.填充节点列表(当前键位技能数量显示列表, 1, 键位背包栏位页数最大, 当前键位技能数量显示集合, "当前键位技能数量显示")
	技能装配界面选项文本显示集合 = self.get_node("技能装配界面选项文本显示集合")
	全局方法.填充节点列表(技能装配界面选项文本显示列表, 1, 1, 技能装配界面选项文本显示集合, "技能装配界面选项文本显示")
	
	键位上技能图标区域集合 = UI内容节点.get_node("键位上技能图标区域集合")
	全局方法.填充节点列表(键位上技能图标区域列表, 1, 键位栏位数最大, 键位上技能图标区域集合, "键位上技能图标区域")
	当前键位技能图标区域集合 = UI内容节点.get_node("当前键位技能图标区域集合")
	全局方法.填充节点列表(当前键位技能图标区域列表, 1, 键位背包栏位页数最大, 当前键位技能图标区域集合, "当前键位技能图标区域")
	技能装配界面选项区域集合 = UI内容节点.get_node("技能装配界面选项区域集合")
	全局方法.填充节点列表(技能装配界面选项区域列表, 1, 1, 技能装配界面选项区域集合, "技能装配界面选项区域")
	
	全局方法.节点列表连接信号(键位上技能图标区域列表, "mouse_entered", 鼠标进入键位上技能图标区域)
	全局方法.节点列表连接信号(键位上技能图标区域列表, "gui_input", 键位上技能图标区域gui输入)
	全局方法.节点列表连接信号(当前键位技能图标区域列表, "mouse_entered", 鼠标进入当前键位技能图标区域)
	全局方法.节点列表连接信号(当前键位技能图标区域列表, "gui_input", 当前键位技能图标区域gui输入)
	全局方法.节点列表连接信号(技能装配界面选项区域列表, "mouse_entered", 鼠标进入装配界面选项区域)
	全局方法.节点列表连接信号(技能装配界面选项区域列表, "gui_input", 装配界面选项区域gui输入)
	
	滑动条图片显示 = UI内容节点.get_node("滑动条图片显示")
	滑动条起始连接点 = UI内容节点.get_node("滑动条起始连接点")
	
	if 全局数据_系统.当前查看技能栏位数 > 全局数据_周期对局.技能背包总栏数:
		全局数据_系统.当前查看技能栏位数 = 1
	if 全局数据_系统.当前查看技能键位组合 > 键位栏位数最大:
		全局数据_系统.当前查看技能键位组合 = 1
	
	match 界面模式扩展:
		1:
			全局数据_系统.角色输入许可 = false
			全局数据_系统.背包界面已打开 = true
			黑幕图片.visible = true
			技能装配界面选项文本显示集合.visible = false
			技能装配界面选项区域集合.visible = false
			主要图片节点.texture = load("res://图片资源/UI/技能界面-Sheet.png")
			技能装配界面选项文本显示列表[1].text = ""
			self.z_index = 4  #仅当是技能界面时才上调显示优先级
		2:
			黑幕图片.visible = false
			技能装配界面选项文本显示集合.visible = true
			技能装配界面选项区域集合.visible = true
			主要图片节点.texture = load("res://图片资源/UI/技能装配界面-Sheet.png")
			技能装配界面选项文本显示列表[1].text = 全局方法.解析自定义文本(全局数据库.通用文本数据库["技能装配界面选项文本1"])
	
	渲染更新_玩家属性信息()
	切换查看键位()
	渲染更新_键位上技能图标()

func _input(输入事件: InputEvent) -> void:
	if 全局数据_系统.UI输入许可:
		match 选择模式:
			1:
				var 此时移动逻辑 = 当前技能界面光标移动逻辑[全局数据_系统.当前查看技能键位组合]
				if 输入事件.is_action_pressed("操作→") and str(此时移动逻辑["此时向右移动"]) != "":
					全局数据_系统.当前查看技能键位组合 = 当前技能界面光标移动逻辑[全局数据_系统.当前查看技能键位组合]["此时向右移动"]
					切换查看键位()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作←") and str(此时移动逻辑["此时向左移动"]) != "":
					全局数据_系统.当前查看技能键位组合 = 当前技能界面光标移动逻辑[全局数据_系统.当前查看技能键位组合]["此时向左移动"]
					切换查看键位()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作↑") and str(此时移动逻辑["此时向上移动"]) != "":
					全局数据_系统.当前查看技能键位组合 = 当前技能界面光标移动逻辑[全局数据_系统.当前查看技能键位组合]["此时向上移动"]
					切换查看键位()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作↓"):
					if str(此时移动逻辑["此时向上移动"]) != "":
						全局数据_系统.当前查看技能键位组合 = 当前技能界面光标移动逻辑[全局数据_系统.当前查看技能键位组合]["此时向上移动"]
						切换查看键位()
						全局方法.UI输入倒计时启动()
					elif 界面模式扩展 == 2:
						选择模式 = 3
						渲染更新_选中指示图片()
						全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作确认"):
					按下键位上技能图标()
					全局方法.UI输入倒计时启动()
			2:
				if 输入事件.is_action_pressed("操作→") and 全局数据_系统.当前查看技能栏位数 < 当前键位背包技能数量:
					全局数据_系统.当前查看技能栏位数 += 1
					渲染更新_当前技能信息()
					渲染更新_选中指示图片()
					渲染更新_键位背包技能图标()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作←") and 全局数据_系统.当前查看技能栏位数 > 1:
					全局数据_系统.当前查看技能栏位数 -= 1
					渲染更新_当前技能信息()
					渲染更新_选中指示图片()
					渲染更新_键位背包技能图标()
					全局方法.UI输入倒计时启动()
				elif ((输入事件.is_action_pressed("操作↓") or 输入事件.is_action_pressed("鼠标滚轮↓")) and 
				全局数据_系统.当前查看技能栏位数 < 当前键位背包技能数量):
					全局数据_系统.当前查看技能栏位数 += 键位背包栏位行数最大
					if 全局数据_系统.当前查看技能栏位数 > 当前键位背包技能数量:
						全局数据_系统.当前查看技能栏位数 = 当前键位背包技能数量
					渲染更新_当前技能信息()
					渲染更新_选中指示图片()
					渲染更新_键位背包技能图标()
					全局方法.UI输入倒计时启动()
				elif ((输入事件.is_action_pressed("操作↑") or 输入事件.is_action_pressed("鼠标滚轮↑")) and
				 全局数据_系统.当前查看技能栏位数 > 1):
					全局数据_系统.当前查看技能栏位数 -= 键位背包栏位行数最大
					if 全局数据_系统.当前查看技能栏位数 < 1:
						全局数据_系统.当前查看技能栏位数 = 1
					渲染更新_当前技能信息()
					渲染更新_选中指示图片()
					渲染更新_键位背包技能图标()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作确认"):
					按下当前键位技能图标()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作取消"):
					退出选择技能模式()
					全局方法.UI输入倒计时启动()
			3:
				if 输入事件.is_action_pressed("操作确认"):
					按下装配界面选项文本()
					全局方法.UI输入倒计时启动()
				elif 输入事件.is_action_pressed("操作取消") or 输入事件.is_action_pressed("操作↑"):
					选择模式 = 1
					渲染更新_选中指示图片()
					全局方法.UI输入倒计时启动()
		if 输入事件.is_action_pressed("菜单1"):
			match 界面模式扩展:
				1:
					关闭技能界面()
					全局方法.UI输入倒计时启动()
				2:
					if 全局数据_周期对局.当前对局进行中 == 0:
						退出到角色选择界面()
		elif 输入事件.is_action_pressed("菜单2"):
			match 界面模式扩展:
				1:
					打开背包界面()
					全局方法.UI输入倒计时启动()

func 切换查看键位() -> void:
	构造当前键位背包技能编号列表()
	全局数据_系统.当前查看技能栏位数 = 1
	var 当前查看技能编号 = 全局数据_周期对局.技能编号_键位[全局数据_系统.当前查看技能键位组合]
	if 当前查看技能编号 > 0:
		全局数据_系统.当前查看技能栏位数 = 当前键位背包技能编号列表.find(当前查看技能编号)
	渲染更新_当前技能信息()
	渲染更新_选中指示图片()
	渲染更新_键位背包技能图标()

func 构造当前键位背包技能编号列表() -> void:
	当前键位背包技能编号列表 = []
	var 技能持有编号列表 = 全局数据_周期对局.技能持有数据.keys()
	if 当前角色技能背包类型 == 2:
		当前键位背包技能编号列表 = 技能持有编号列表.duplicate()
	else:
		var 当前技能过滤数据库 = 当前角色技能数据库_技能键位次级索引[全局数据_系统.当前查看技能键位组合]
		for 遍历 in 技能持有编号列表:
			if 遍历 in 当前技能过滤数据库:
				当前键位背包技能编号列表.append(遍历)
	当前键位背包技能编号列表.push_front(0)  #将索引0填入一个值进行占位
	当前键位背包技能数量 = 当前键位背包技能编号列表.size() - 1

func 渲染更新_选中指示图片() -> void:
	match 选择模式:
		1:
			选中指示图片.texture = load(全局数据库.图片资源数据库["展示框选中"])
			var 连接点坐标 = 键位上技能等级框显示列表[全局数据_系统.当前查看技能键位组合].global_position
			选中指示图片.global_position = 连接点坐标
			选中指示图片.visible = true
		2:
			var 计算键位背包当页栏位数 = 全局数据_系统.当前查看技能栏位数 % 键位背包栏位页数最大
			if 计算键位背包当页栏位数 == 0:
				计算键位背包当页栏位数 = 键位背包栏位页数最大
			选中指示图片.texture = load(全局数据库.图片资源数据库["展示框选中"])
			var 连接点坐标 = 当前键位技能等级框显示列表[计算键位背包当页栏位数].global_position
			选中指示图片.global_position = 连接点坐标
			选中指示图片.visible = true
		3:
			选中指示图片.texture = load(全局数据库.图片资源数据库["继续下一波选中"])
			var 连接点坐标 = 技能装配界面选项文本显示列表[1].global_position
			选中指示图片.global_position = 连接点坐标
			选中指示图片.visible = true

func 渲染更新_键位上技能图标() -> void:
	for 索引 in range(1, 键位栏位数最大 + 1):
		var 遍历等级框显示节点 = 键位上技能等级框显示列表[索引]
		var 遍历图标显示节点 = 键位上技能图标显示列表[索引]
		var 遍历数量显示节点 = 键位上技能数量显示列表[索引]
		var 遍历技能编号 = 全局数据_周期对局.技能编号_键位[索引]
		遍历等级框显示节点.texture = null
		遍历图标显示节点.texture = null
		遍历数量显示节点.text = ""
		if 遍历技能编号 == 0:
			continue
		var 遍历技能等级 = 当前角色技能数据库[遍历技能编号]["技能等级"]
		var 拼接等级框键名 = "展示框_等级%d" % 遍历技能等级
		遍历等级框显示节点.texture = load(全局数据库.图片资源数据库[拼接等级框键名])
		var 拼接图标键名 = 当前角色名称 + ("_技能图标%d" % 遍历技能编号)
		遍历图标显示节点.texture = load(全局数据库.图片资源数据库[拼接图标键名])
		var 遍历技能数量 = 全局数据_周期对局.技能持有数据[遍历技能编号]
		if 遍历技能数量 != -999:
			遍历数量显示节点.text = str(遍历技能数量)

func 渲染更新_键位背包技能图标() -> void:
	var 计算键位背包当前页数 = ceil(float(全局数据_系统.当前查看技能栏位数) / 键位背包栏位页数最大)
	for 索引 in range(1, 键位背包栏位页数最大 + 1):
		var 遍历等级框显示节点 = 当前键位技能等级框显示列表[索引]
		var 遍历图标显示节点 = 当前键位技能图标显示列表[索引]
		var 遍历数量显示节点 = 当前键位技能数量显示列表[索引]
		var 遍历展示框黑幕显示节点 = 当前键位展示框黑幕显示列表[索引]
		var 当前遍历栏位数 : int = 索引 + (计算键位背包当前页数 - 1) * 键位背包栏位页数最大
		遍历等级框显示节点.texture = null
		遍历图标显示节点.texture = null
		遍历数量显示节点.text = ""
		遍历展示框黑幕显示节点.visible = false
		if 当前遍历栏位数 > 当前键位背包技能数量:
			continue
		var 遍历技能编号 = 当前键位背包技能编号列表[当前遍历栏位数]
		var 遍历技能等级 = 当前角色技能数据库[遍历技能编号]["技能等级"]
		var 拼接等级框键名 = "展示框_等级%d" % 遍历技能等级
		遍历等级框显示节点.texture = load(全局数据库.图片资源数据库[拼接等级框键名])
		var 拼接图标键名 = 当前角色名称 + ("_技能图标%d" % 遍历技能编号)
		遍历图标显示节点.texture = load(全局数据库.图片资源数据库[拼接图标键名])
		var 遍历技能数量 = 全局数据_周期对局.技能持有数据[遍历技能编号]
		if 遍历技能编号 == 全局数据_周期对局.技能编号_键位[全局数据_系统.当前查看技能键位组合]:
			遍历展示框黑幕显示节点.visible = true
		if 遍历技能数量 != -999:
			遍历数量显示节点.text = str(遍历技能数量)
			if 遍历技能数量 <= 0:
				遍历展示框黑幕显示节点.visible = true
	
	var 计算键位背包总页数 = ceil(float(当前键位背包技能数量) / 键位背包栏位页数最大)
	if 计算键位背包总页数 > 1:
		滑动条图片显示.visible = true
		var 翻页比例 = (计算键位背包当前页数 - 1) / (计算键位背包总页数 - 1)
		var 滑动条长度 = max(滑动条最大移动距离 / 计算键位背包总页数, 滑动条最小长度)
		var 滑动条实际移动距离 = 滑动条最大移动距离 - 滑动条长度
		if 当前角色技能背包类型 == 2:
			var 滑动条位置 = 滑动条起始连接点.position.y + 滑动条实际移动距离 * 翻页比例
			滑动条图片显示.scale.y = 滑动条长度
			滑动条图片显示.position.y = 滑动条位置
		else:
			var 滑动条位置 = 滑动条起始连接点.position.x + 滑动条实际移动距离 * 翻页比例
			滑动条图片显示.scale.x = 滑动条长度
			滑动条图片显示.position.x = 滑动条位置
	else:
		滑动条图片显示.visible = false

func 渲染更新_当前技能信息() -> void:
	var 当前查看技能编号 = 0
	match 选择模式:
		1:
			当前查看技能编号 = 全局数据_周期对局.技能编号_键位[全局数据_系统.当前查看技能键位组合]
		2:
			if 当前键位背包技能数量 > 0:
				当前查看技能编号 = 当前键位背包技能编号列表[全局数据_系统.当前查看技能栏位数]
	当前技能等级框显示.texture = null
	当前技能图标显示.texture = null
	当前技能名称显示.text = ""
	当前技能描述显示.text = ""
	if 当前查看技能编号 > 0:
		var 拼接等级框键名 = "展示框_等级%d" % 当前角色技能数据库[当前查看技能编号]["技能等级"]
		当前技能等级框显示.texture = load(全局数据库.图片资源数据库[拼接等级框键名])
		var 拼接图标键名 = 当前角色名称 + ("_技能图标%d" % 当前查看技能编号)
		当前技能图标显示.texture = load(全局数据库.图片资源数据库[拼接图标键名])
		var 当前技能数据 = 当前角色技能数据库[当前查看技能编号]
		当前技能名称显示.text = 全局方法.解析自定义文本(当前技能数据["技能名称"])
		当前技能描述显示.text = 全局方法.生成技能描述文本(当前查看技能编号)

func 渲染更新_玩家属性信息() -> void:
	玩家属性名称显示.text = 全局方法.输出玩家属性名称字符串()
	玩家属性数值显示.text = 全局方法.输出玩家属性数值字符串()

func 按下键位上技能图标() -> void:
	选择模式 = 2
	渲染更新_选中指示图片()
	渲染更新_键位背包技能图标()
	渲染更新_当前技能信息()

func 按下当前键位技能图标() -> void:
	#只有在技能装配界面，并且不是卡组技能类型的情况下，才允许按下键位背包的图标，从而装配技能
	if 界面模式扩展 == 2 and 当前角色技能背包类型 != 2:
		if 全局数据_系统.当前查看技能栏位数 <= 当前键位背包技能数量:
			var 当前查看技能编号 = 当前键位背包技能编号列表[全局数据_系统.当前查看技能栏位数]
			var 当前查看技能数量 = 全局数据_周期对局.技能持有数据[当前查看技能编号]
			if 当前查看技能数量 > 0 or 当前查看技能数量 == -999:
				var 当前查看技能对应键位 = 当前角色技能数据库[当前查看技能编号]["技能键位"]
				if 全局数据_周期对局.技能编号_键位[当前查看技能对应键位] == 当前查看技能编号:
					if 当前查看技能数量 != -999:
						全局数据_周期对局.技能编号_键位[当前查看技能对应键位] = 0
				else:
					全局数据_周期对局.技能编号_键位[当前查看技能对应键位] = 当前查看技能编号
				选择模式 = 1
				渲染更新_键位上技能图标()
				渲染更新_选中指示图片()
				渲染更新_键位背包技能图标()

func 按下装配界面选项文本() -> void:
	全局方法.开始下一波次()

func 退出选择技能模式() -> void:
	选择模式 = 1
	渲染更新_选中指示图片()
	渲染更新_键位背包技能图标()
	渲染更新_当前技能信息()

func 鼠标进入键位上技能图标区域(序号 : int) -> void:
	选择模式 = 1
	全局数据_系统.当前查看技能键位组合 = 序号
	切换查看键位()

func 鼠标进入当前键位技能图标区域(序号 : int) -> void:
	var 计算键位背包当前页数 = ceil(float(全局数据_系统.当前查看技能栏位数) / 键位背包栏位页数最大)
	var 尝试计算查看栏位数 : int = 序号 + (计算键位背包当前页数 - 1) * 键位背包栏位页数最大
	if 尝试计算查看栏位数 <= 当前键位背包技能数量:
		选择模式 = 2
		全局数据_系统.当前查看技能栏位数 = 尝试计算查看栏位数
		渲染更新_当前技能信息()
		渲染更新_选中指示图片()
		渲染更新_键位背包技能图标()

func 鼠标进入装配界面选项区域(_序号 : int) -> void:
	选择模式 = 3
	渲染更新_选中指示图片()
	全局方法.UI输入倒计时启动()

func 键位上技能图标区域gui输入(输入事件 : InputEvent, 序号 : int) -> void:
	if not 输入事件.is_pressed():
		return
	if 输入事件 is InputEventMouseButton:
		if 输入事件.button_index == MOUSE_BUTTON_LEFT:
			鼠标进入键位上技能图标区域(序号)
			按下键位上技能图标()

func 当前键位技能图标区域gui输入(输入事件 : InputEvent, 序号 : int) -> void:
	if not 输入事件.is_pressed():
		return
	if 输入事件 is InputEventMouseButton:
		var 计算键位背包当前页数 = ceil(float(全局数据_系统.当前查看技能栏位数) / 键位背包栏位页数最大)
		var 尝试计算查看栏位数 : int = 序号 + (计算键位背包当前页数 - 1) * 键位背包栏位页数最大
		if 尝试计算查看栏位数 <= 当前键位背包技能数量:
			if 输入事件.button_index == MOUSE_BUTTON_LEFT:
				鼠标进入当前键位技能图标区域(序号)
				按下当前键位技能图标()

func 装配界面选项区域gui输入(输入事件 : InputEvent, 序号 : int) -> void:
	if not 输入事件.is_pressed():
		return
	if 输入事件 is InputEventMouseButton:
		if 输入事件.button_index == MOUSE_BUTTON_LEFT:
			鼠标进入装配界面选项区域(序号)
			按下装配界面选项文本()

func 关闭技能界面() -> void:
	全局数据_系统.背包界面已打开 = false
	全局方法.UI输入倒计时启动()
	get_tree().paused = false
	self.queue_free()

func 打开背包界面() -> void:
	if not 全局数据_系统.是否禁用打开背包界面:
		全局方法.打开背包界面()
		self.queue_free()

func 退出到角色选择界面() -> void:
	全局方法.切换场景("角色选择界面场景")
