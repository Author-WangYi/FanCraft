extends Control

var 选择模式 : int = 2  #1-选择角色筛选模式中，2-选择角色中
var 栏位页数最大 : int = 12
var 栏位行数最大 : int = 4
var 筛选模式最大 : int = 2
var 当前筛选模式角色编号列表 : Array #索引0略过，从索引1开始，这里记录的是角色编号，也就是角色数据库的key
var 当前筛选模式角色数量 : int
var 滑动条最小长度 : int = 60
var 滑动条最大移动距离 : int = 324

var UI内容节点 = null
var 选中指示图片 = null
var 当前角色等级框显示 = null
var 当前角色图标显示 = null
var 当前筛选类型显示 = null
var 当前角色名称显示 = null
var 当前角色描述显示 = null
var 玩家属性名称显示 = null
var 玩家属性数值显示 = null

var 角色等级框显示集合 = null
var 角色图标显示集合 = null
var 图标连接点集合 = null
var 角色类型筛选连接点集合 = null
var 角色等级框显示列表 : Array
var 角色图标显示列表 : Array
var 图标连接点列表 : Array
var 角色类型筛选连接点列表 : Array

var 角色图标区域集合 = null
var 角色类型筛选按钮区域集合 = null
var 角色图标区域列表 : Array
var 角色类型筛选按钮区域列表 : Array

var 滑动条图片显示 = null
var 滑动条起始连接点 = null

func _ready() -> void:
	UI内容节点 = self.get_node("UI内容节点")
	选中指示图片 = UI内容节点.get_node("选中指示图片")
	当前角色等级框显示 = UI内容节点.get_node("当前角色等级框显示")
	当前角色图标显示 = UI内容节点.get_node("当前角色图标显示")
	当前筛选类型显示 = self.get_node("当前筛选类型显示")
	当前角色名称显示 = self.get_node("当前角色名称显示")
	当前角色描述显示 = self.get_node("当前角色描述显示")
	玩家属性名称显示 = self.get_node("玩家属性名称显示")
	玩家属性数值显示 = self.get_node("玩家属性数值显示")
	
	角色等级框显示集合 = UI内容节点.get_node("角色等级框显示集合")
	角色图标显示集合 = UI内容节点.get_node("角色图标显示集合")
	图标连接点集合 = UI内容节点.get_node("图标连接点集合")
	角色类型筛选连接点集合 = UI内容节点.get_node("角色类型筛选连接点集合")
	全局方法.填充节点列表(角色等级框显示列表, 1, 栏位页数最大, 角色等级框显示集合, "角色等级框显示")
	全局方法.填充节点列表(角色图标显示列表, 1, 栏位页数最大, 角色图标显示集合, "角色图标显示")
	全局方法.填充节点列表(图标连接点列表, 1, 栏位页数最大, 图标连接点集合, "图标连接点")
	全局方法.填充节点列表(角色类型筛选连接点列表, 1, 1, 角色类型筛选连接点集合, "角色类型筛选连接点")
	
	角色图标区域集合 = self.get_node("角色图标区域集合")
	角色类型筛选按钮区域集合 = self.get_node("角色类型筛选按钮区域集合")
	全局方法.填充节点列表(角色图标区域列表, 1, 栏位页数最大, 角色图标区域集合, "角色图标区域")
	全局方法.填充节点列表(角色类型筛选按钮区域列表, 1, 2, 角色类型筛选按钮区域集合, "角色类型筛选按钮区域")
	
	全局方法.节点列表连接信号(角色图标区域列表, "mouse_entered", 鼠标进入角色图标区域)
	全局方法.节点列表连接信号(角色图标区域列表, "gui_input", 角色图标区域gui输入)
	全局方法.节点列表连接信号(角色类型筛选按钮区域列表, "mouse_entered", 鼠标进入筛选按钮区域)
	全局方法.节点列表连接信号(角色类型筛选按钮区域列表, "gui_input", 筛选按钮区域gui输入)
	
	滑动条图片显示 = UI内容节点.get_node("滑动条图片显示")
	滑动条起始连接点 = UI内容节点.get_node("滑动条起始连接点")
	
	构造当前类型角色字典()
	渲染更新_当前角色信息()
	渲染更新_选中指示图片()
	渲染更新_筛选类型显示()
	渲染更新_角色图标()

func _input(输入事件: InputEvent) -> void:
	if 全局数据_系统.UI输入许可:
		if 选择模式 == 1:
			if Input.is_action_just_pressed("操作→"):
				全局数据_系统.当前查看角色类型筛选 += 1
				全局数据_系统.当前查看角色栏位数 = 1
				if 全局数据_系统.当前查看角色类型筛选 > 筛选模式最大:
					全局数据_系统.当前查看角色类型筛选 = 0
				渲染更新_筛选类型显示()
				构造当前类型角色字典()
				渲染更新_角色图标()
				全局方法.UI输入倒计时启动()
			elif Input.is_action_just_pressed("操作←"):
				全局数据_系统.当前查看角色类型筛选 -= 1
				全局数据_系统.当前查看角色栏位数 = 1
				if 全局数据_系统.当前查看角色类型筛选 < 0:
					全局数据_系统.当前查看角色类型筛选 = 筛选模式最大
				渲染更新_筛选类型显示()
				构造当前类型角色字典()
				渲染更新_角色图标()
				全局方法.UI输入倒计时启动()
			elif 输入事件.is_action_pressed("操作确认"):
				选择模式 = 2
				渲染更新_选中指示图片()
				渲染更新_当前角色信息()
				全局方法.UI输入倒计时启动()
			elif 输入事件.is_action_pressed("菜单1") or 输入事件.is_action_pressed("操作取消"):
				退出到标题界面()
				全局方法.UI输入倒计时启动()
				
		elif 选择模式 == 2:
			if Input.is_action_just_pressed("操作→") and 全局数据_系统.当前查看角色栏位数 < 当前筛选模式角色数量:
				全局数据_系统.当前查看角色栏位数 += 1
				全局数据_系统.当前查看背包栏位数 = 1
				全局数据_系统.当前查看技能键位组合 = 1
				全局数据_系统.当前查看技能栏位数 = 1
				渲染更新_当前角色信息()
				渲染更新_选中指示图片()
				渲染更新_角色图标()
				全局方法.UI输入倒计时启动()
			elif Input.is_action_just_pressed("操作←") and 全局数据_系统.当前查看角色栏位数 > 1:
				全局数据_系统.当前查看角色栏位数 -= 1
				全局数据_系统.当前查看背包栏位数 = 1
				全局数据_系统.当前查看技能键位组合 = 1
				全局数据_系统.当前查看技能栏位数 = 1
				渲染更新_当前角色信息()
				渲染更新_选中指示图片()
				渲染更新_角色图标()
				全局方法.UI输入倒计时启动()
			elif ((Input.is_action_just_pressed("操作↓") or 输入事件.is_action_pressed("鼠标滚轮↓")) and 
				全局数据_系统.当前查看角色栏位数 < 当前筛选模式角色数量):
				全局数据_系统.当前查看角色栏位数 += 栏位行数最大
				if 全局数据_系统.当前查看角色栏位数 > 当前筛选模式角色数量:
					全局数据_系统.当前查看角色栏位数 = 当前筛选模式角色数量
				全局数据_系统.当前查看背包栏位数 = 1
				全局数据_系统.当前查看技能键位组合 = 1
				全局数据_系统.当前查看技能栏位数 = 1
				渲染更新_当前角色信息()
				渲染更新_选中指示图片()
				渲染更新_角色图标()
				全局方法.UI输入倒计时启动()
			elif ((Input.is_action_just_pressed("操作↑") or 输入事件.is_action_pressed("鼠标滚轮↑")) and
				全局数据_系统.当前查看角色栏位数 > 1):
				全局数据_系统.当前查看角色栏位数 -= 栏位行数最大
				if 全局数据_系统.当前查看角色栏位数 < 1:
					全局数据_系统.当前查看角色栏位数 = 1
				全局数据_系统.当前查看背包栏位数 = 1
				全局数据_系统.当前查看技能键位组合 = 1
				全局数据_系统.当前查看技能栏位数 = 1
				渲染更新_当前角色信息()
				渲染更新_选中指示图片()
				渲染更新_角色图标()
				全局方法.UI输入倒计时启动()
			elif 输入事件.is_action_pressed("操作确认"):
				按下角色图标()
				全局方法.UI输入倒计时启动()
			elif 输入事件.is_action_pressed("菜单1") or 输入事件.is_action_pressed("操作取消"):
				选择模式 = 1
				渲染更新_选中指示图片()
				全局方法.UI输入倒计时启动()

func 渲染更新_筛选类型显示() -> void:
	match 全局数据_系统.当前查看角色类型筛选:
		0:
			当前筛选类型显示.text = "全部"
		1:
			当前筛选类型显示.text = "同人"
		2:
			当前筛选类型显示.text = "onknow"

func 渲染更新_选中指示图片() -> void:
	match 选择模式:
		1:
			选中指示图片.texture = 全局数据库.图片资源预加载数据库["角色类型筛选选中"]
			var 连接点坐标 = 角色类型筛选连接点列表[1].global_position
			选中指示图片.global_position = 连接点坐标
			选中指示图片.visible = true
		2:
			选中指示图片.texture = 全局数据库.图片资源预加载数据库["展示框选中"]
			var 计算当页栏位数 = 全局数据_系统.当前查看角色栏位数 % 栏位页数最大
			if 计算当页栏位数 == 0:
				计算当页栏位数 = 栏位页数最大
			var 连接点坐标 = 图标连接点列表[计算当页栏位数].global_position
			选中指示图片.global_position = 连接点坐标
			选中指示图片.visible = true

func 渲染更新_角色图标() -> void:
	var 计算当前页数 = ceil(float(全局数据_系统.当前查看角色栏位数) / 栏位页数最大)
	for 索引 in range(1, 角色图标显示列表.size()):
		var 遍历等级框显示节点 = 角色等级框显示列表[索引]
		var 遍历图标显示节点 = 角色图标显示列表[索引]
		var 当前筛选模式角色序号 = 索引 + (计算当前页数 - 1) * 栏位页数最大  #角色在当前筛选模式角色编号列表中的序号
		if 当前筛选模式角色序号 > 当前筛选模式角色数量:
			遍历等级框显示节点.texture = null
			遍历图标显示节点.texture = null
			continue
		var 遍历角色编号 = 当前筛选模式角色编号列表[当前筛选模式角色序号]
		var 遍历角色等级 = 1
		if 全局数据_游玩进度.角色通过最大波次.has(遍历角色编号):
			var 遍历角色通过波次 = 全局数据_游玩进度.角色通过最大波次[遍历角色编号]
			for 等级遍历 in range(1, 全局数据_环境.角色等级需要通过波次.size() + 1):
				if 遍历角色通过波次 < 全局数据_环境.角色等级需要通过波次[等级遍历]:
					break
				遍历角色等级 = 等级遍历
		var 拼接等级框键名 = "角色展示框_等级%d" % 遍历角色等级
		遍历等级框显示节点.texture = 全局数据库.图片资源预加载数据库[拼接等级框键名]
		var 拼接图标键名
		if 全局数据_环境.Steam特供版 == false:
			拼接图标键名 = "角色图标%d" % 遍历角色编号
		else:
			拼接图标键名 = "角色图标_Steam特供版%d" % 遍历角色编号
		遍历图标显示节点.texture = 全局数据库.图片资源预加载数据库[拼接图标键名]
	
	var 计算总页数 = ceil(float(当前筛选模式角色数量) / 栏位页数最大)
	if 计算总页数 > 1:
		滑动条图片显示.visible = true
		var 翻页比例 = (计算当前页数 - 1) / (计算总页数 - 1)
		var 滑动条长度 = max(滑动条最大移动距离 / 计算总页数, 滑动条最小长度)
		var 滑动条实际移动距离 = 滑动条最大移动距离 - 滑动条长度
		var 滑动条位置 = 滑动条起始连接点.position.y + 滑动条实际移动距离 * 翻页比例
		滑动条图片显示.scale.y = 滑动条长度
		滑动条图片显示.position.y = 滑动条位置
	else:
		滑动条图片显示.visible = false

func 渲染更新_当前角色信息() -> void:
	#虽然名为渲染，但是更新图标文本的同时也会更新属性、道具、技能等周期对局的数据，换角色时也要重置周期对局的数据
	var 当前角色编号 = 当前筛选模式角色编号列表[全局数据_系统.当前查看角色栏位数]
	全局方法.导入角色初始数据(当前角色编号)
	
	var 拼接等级框键名 = "角色展示框_等级1"
	当前角色等级框显示.texture = 全局数据库.图片资源预加载数据库[拼接等级框键名]
	
	var 拼接图标键名
	if 全局数据_环境.Steam特供版 == false:
		拼接图标键名 = "角色图标%d" % 当前角色编号
	else:
		拼接图标键名 = "角色图标_Steam特供版%d" % 当前角色编号
	当前角色图标显示.texture = 全局数据库.图片资源预加载数据库[拼接图标键名]
	
	var 当前角色数据库 = 全局数据库.角色数据库[当前角色编号]
	if 全局数据_环境.Steam特供版 == false:
		当前角色名称显示.text = 全局方法.解析自定义文本(当前角色数据库["角色名称"])
		当前角色描述显示.text = 全局方法.解析自定义文本(当前角色数据库["角色描述"])
	else:
		当前角色名称显示.text = 全局方法.解析自定义文本(当前角色数据库["角色名称_Steam特供版"])
		当前角色描述显示.text = 全局方法.解析自定义文本(当前角色数据库["角色描述_Steam特供版"])
	
	玩家属性名称显示.text = 全局方法.输出玩家属性名称字符串()
	玩家属性数值显示.text = 全局方法.输出玩家属性数值字符串()

func 构造当前类型角色字典() -> void:
	if 全局数据_系统.当前查看角色类型筛选 == 0:
		当前筛选模式角色编号列表 = 全局数据库.角色数据库.keys()
		当前筛选模式角色编号列表.sort()
	else:
		当前筛选模式角色编号列表 = 全局数据库.角色数据库_筛选类型次级索引[全局数据_系统.当前查看角色类型筛选].duplicate()
	当前筛选模式角色编号列表.push_front(0)  #将索引0填入一个值进行占位
	当前筛选模式角色数量 = 当前筛选模式角色编号列表.size() - 1

func 鼠标进入筛选按钮区域(_序号 : int) -> void:
	选择模式 = 1
	渲染更新_选中指示图片()

func 鼠标进入角色图标区域(序号 : int) -> void:
	var 计算当前页数 = ceil(float(全局数据_系统.当前查看角色栏位数) / 栏位页数最大)
	var 尝试计算查看栏位数 = 序号 + (计算当前页数 - 1) * 栏位页数最大
	if 尝试计算查看栏位数 <= 当前筛选模式角色数量:
		选择模式 = 2
		全局数据_系统.当前查看角色栏位数 = 尝试计算查看栏位数
		全局数据_系统.当前查看背包栏位数 = 1
		全局数据_系统.当前查看技能键位组合 = 1
		全局数据_系统.当前查看技能栏位数 = 1
		渲染更新_当前角色信息()
		渲染更新_选中指示图片()

func 筛选按钮区域gui输入(输入事件 : InputEvent, 序号 : int) -> void:
	if not 输入事件.is_pressed():
		return
	if 输入事件 is InputEventMouseButton:
		if 输入事件.button_index == MOUSE_BUTTON_LEFT:
			match 序号:
				2:
					全局数据_系统.当前查看角色类型筛选 += 1
					全局数据_系统.当前查看角色栏位数 = 1
					if 全局数据_系统.当前查看角色类型筛选 > 筛选模式最大:
						全局数据_系统.当前查看角色类型筛选 = 0
					#鼠标进入筛选按钮区域(序号)
					渲染更新_筛选类型显示()
					构造当前类型角色字典()
					渲染更新_角色图标()
				1:
					全局数据_系统.当前查看角色类型筛选 -= 1
					全局数据_系统.当前查看角色栏位数 = 1
					if 全局数据_系统.当前查看角色类型筛选 < 0:
						全局数据_系统.当前查看角色类型筛选 = 筛选模式最大
					#鼠标进入筛选按钮区域(序号)
					渲染更新_筛选类型显示()
					构造当前类型角色字典()
					渲染更新_角色图标()

func 角色图标区域gui输入(输入事件 : InputEvent, 序号 : int) -> void:
	var 计算当前页数 = ceil(float(全局数据_系统.当前查看角色栏位数) / 栏位页数最大)
	var 尝试计算查看栏位数 = 序号 + (计算当前页数 - 1) * 栏位页数最大
	if 尝试计算查看栏位数 <= 当前筛选模式角色数量:
		if not 输入事件.is_pressed():
			return
		if 输入事件 is InputEventMouseButton:
			if 输入事件.button_index == MOUSE_BUTTON_LEFT:
				#鼠标进入角色图标区域(序号)
				按下角色图标()

func 按下角色图标() -> void:
	if 全局数据_环境.Steam特供版 == true and not 当前筛选模式角色编号列表[全局数据_系统.当前查看角色栏位数] in 全局数据_环境.Steam特供版角色列表:
		return
	全局数据_周期对局.当前角色编号 = 当前筛选模式角色编号列表[全局数据_系统.当前查看角色栏位数]
	全局方法.播放音频("基础音效_按键声2")
	全局方法.切换场景("道具解锁界面场景")

func 退出到标题界面() -> void:
