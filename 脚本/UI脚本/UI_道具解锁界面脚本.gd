extends Control

var 选择栏位数 : int = 2  #1-返回，2-继续
var 栏位数最大 : int = 2

var UI内容节点 = null
var 选中指示图片 = null
var 当前角色等级框显示 = null
var 当前角色图标显示 = null

var 展示框黑幕显示集合 = null
var 解锁道具等级框显示集合 = null
var 解锁道具图标显示集合 = null
var 选项连接点集合 = null
var 展示框黑幕显示列表 : Array
var 解锁道具等级框显示列表 : Array
var 解锁道具图标显示列表 : Array
var 选项连接点列表 : Array

var 解锁道具名称显示集合 = null
var 解锁道具描述显示集合 = null
var 道具解锁界面条件文本集合 = null
var 选项文本集合 = null
var 解锁道具名称显示列表 : Array
var 解锁道具描述显示列表 : Array
var 道具解锁界面条件文本列表 : Array
var 选项文本列表 : Array

var 当前角色解锁道具数据 : Dictionary

func _ready() -> void:
	当前角色解锁道具数据 = 全局数据库.角色解锁进度数据库[全局数据_周期对局.当前角色编号]
	
	UI内容节点 = self.get_node("UI内容节点")
	选中指示图片 = UI内容节点.get_node("选中指示图片")
	当前角色等级框显示 = UI内容节点.get_node("当前角色等级框显示")
	当前角色图标显示 = UI内容节点.get_node("当前角色图标显示")
	
	展示框黑幕显示集合 =  UI内容节点.get_node("展示框黑幕显示集合")
	解锁道具等级框显示集合 = UI内容节点.get_node("解锁道具等级框显示集合")
	解锁道具图标显示集合 = UI内容节点.get_node("解锁道具图标显示集合")
	选项连接点集合 = UI内容节点.get_node("选项连接点集合")
	全局方法.填充节点列表(展示框黑幕显示列表, 2, 当前角色解锁道具数据.size() + 1, 展示框黑幕显示集合, "展示框黑幕显示")
	全局方法.填充节点列表(解锁道具等级框显示列表, 2, 当前角色解锁道具数据.size() + 1, 解锁道具等级框显示集合, "解锁道具等级框显示")
	全局方法.填充节点列表(解锁道具图标显示列表, 2, 当前角色解锁道具数据.size() + 1, 解锁道具图标显示集合, "解锁道具图标显示")
	全局方法.填充节点列表(选项连接点列表, 1, 2, 选项连接点集合, "选项连接点")

	解锁道具名称显示集合 = self.get_node("解锁道具名称显示集合")
	解锁道具描述显示集合 = self.get_node("解锁道具描述显示集合")
	道具解锁界面条件文本集合 = self.get_node("道具解锁界面条件文本集合")
	全局方法.填充节点列表(解锁道具名称显示列表, 2, 当前角色解锁道具数据.size() + 1, 解锁道具名称显示集合, "解锁道具名称显示")
	全局方法.填充节点列表(解锁道具描述显示列表, 2, 当前角色解锁道具数据.size() + 1, 解锁道具描述显示集合, "解锁道具描述显示")
	全局方法.填充节点列表(道具解锁界面条件文本列表, 2, 当前角色解锁道具数据.size() + 1, 道具解锁界面条件文本集合, "道具解锁界面条件文本")
	
	选项文本集合 = self.get_node("选项文本集合")
	全局方法.填充节点列表(选项文本列表, 1, 2, 选项文本集合, "选项文本")
	
	全局方法.节点列表连接信号(选项文本列表, "mouse_entered", 鼠标进入选项文本)
	全局方法.节点列表连接信号(选项文本列表, "gui_input", 选项文本gui输入)
	
	渲染更新_角色与解锁道具信息()
	渲染更新_选中指示图片()

func _input(输入事件: InputEvent) -> void:
	if 全局数据_系统.UI输入许可:
		if 输入事件.is_action_pressed("操作→"):
			if 选择栏位数 < 栏位数最大:
				选择栏位数 += 1
				渲染更新_选中指示图片()
				全局方法.UI输入倒计时启动()
		elif 输入事件.is_action_pressed("操作←"):
			if 选择栏位数 > 1:
				选择栏位数 -= 1
				渲染更新_选中指示图片()
				全局方法.UI输入倒计时启动()
		elif 输入事件.is_action_pressed("操作确认"):
			按下选项文本(选择栏位数)
			全局方法.UI输入倒计时启动()
		elif 输入事件.is_action_pressed("操作取消") or 输入事件.is_action_pressed("菜单1"):
			退出到角色选择界面()
			全局方法.UI输入倒计时启动()

func 渲染更新_选中指示图片() -> void:
	var 坐标 = 选项连接点列表[选择栏位数].global_position
	选中指示图片.global_position = 坐标
	选中指示图片.visible = true

func 渲染更新_角色与解锁道具信息() -> void:
	var 当前角色等级 = 1
	if 全局数据_游玩进度.角色通过最大波次.has(全局数据_周期对局.当前角色编号):
		var 当前角色通过波次 = 全局数据_游玩进度.角色通过最大波次[全局数据_周期对局.当前角色编号]
		for 等级遍历 in range(1, 全局数据_环境.角色等级需要通过波次.size() + 1):
			if 当前角色通过波次 < 全局数据_环境.角色等级需要通过波次[等级遍历]:
				break
			当前角色等级 = 等级遍历
	var 拼接等级框键名 = "角色展示框_等级%d" % 当前角色等级
	当前角色等级框显示.texture = 全局数据库.图片资源预加载数据库[拼接等级框键名]
	var 拼接图标键名 = "角色图标%d" % 全局数据_周期对局.当前角色编号
	当前角色图标显示.texture = 全局数据库.图片资源预加载数据库[拼接图标键名]
	for 键 in 当前角色解锁道具数据:
		var 键转序号 = int(键)
		var 遍历道具编号 = int(当前角色解锁道具数据[键])
		if 遍历道具编号 > 0:
			var 遍历道具数据 = 全局数据库.道具数据库[遍历道具编号]
			var 拼接道具等级框键名 = "展示框_等级%d" % 遍历道具数据["道具等级"]
			解锁道具等级框显示列表[键转序号].texture = 全局数据库.图片资源预加载数据库[拼接道具等级框键名]
			var 拼接道具图标键名 = "道具图标%d" % 遍历道具编号
			解锁道具图标显示列表[键转序号].texture = 全局数据库.图片资源预加载数据库[拼接道具图标键名]
			解锁道具名称显示列表[键转序号].text = 全局方法.解析自定义文本(遍历道具数据["道具名称"])
			解锁道具描述显示列表[键转序号].text = 全局方法.生成道具描述文本(遍历道具编号)
			if 全局数据_游玩进度.道具解锁数据.get(遍历道具编号) == true:
				展示框黑幕显示列表[键转序号].visible = false
				道具解锁界面条件文本列表[键转序号].add_theme_color_override("default_color", Color("#72f27a"))
			else:
				展示框黑幕显示列表[键转序号].visible = true

func 鼠标进入选项文本(序号 : int) -> void:
	选择栏位数 = 序号
	渲染更新_选中指示图片()

func 选项文本gui输入(输入事件 : InputEvent, 序号 : int) -> void:		
	if not 输入事件.is_pressed():
		return
	if 输入事件 is InputEventMouseButton:
		if 输入事件.button_index == MOUSE_BUTTON_LEFT:
			按下选项文本(序号)

func 按下选项文本(序号 : int) -> void:
	if 序号 == 1:
		全局方法.播放音频("基础音效_按键声2")
		退出到角色选择界面()
	if 序号 == 2:
		全局方法.播放音频("基础音效_按键声2")
		全局方法.切换场景("技能装配界面场景")

func 退出到角色选择界面() -> void:
	全局方法.切换场景("角色选择界面场景")
