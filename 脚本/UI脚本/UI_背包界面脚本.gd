extends Control
#UI架构经过一次大改，技能界面用了新架构，但是背包界面已经做好了也没什么bug，就用老架构凑合

var 栏位页数最大 : int = 16
var 栏位行数最大 : int = 4
var 滑动条最小长度 : int = 60
var 滑动条最大移动距离 : int = 324

var UI内容节点 = null
var 选中指示图片 = null
var 当前道具等级框显示 = null
var 当前道具图标显示 = null
var 当前道具名称显示 = null
var 当前道具描述显示 = null
var 玩家属性名称显示 = null
var 玩家属性数值显示 = null

var 背包道具等级框显示集合 = null
var 背包道具图标显示集合 = null
var 背包道具等级框显示列表 : Array
var 背包道具图标显示列表 : Array

var 背包道具图标区域集合 = null
var 背包道具图标区域列表 : Array

var 背包道具数量显示集合 = null
var 背包道具数量显示列表 : Array

var 滑动条图片显示 = null
var 滑动条起始连接点 = null

func _ready() -> void:
	self.process_mode = Node.PROCESS_MODE_ALWAYS
	get_tree().paused = true
	全局数据_系统.角色输入许可 = false
	全局数据_系统.背包界面已打开 = true
	
	UI内容节点 = self.get_node("UI内容节点")
	选中指示图片 = UI内容节点.get_node("选中指示图片")
	当前道具等级框显示 = UI内容节点.get_node("当前道具等级框显示")
	当前道具图标显示 = UI内容节点.get_node("当前道具图标显示")
	当前道具名称显示 = self.get_node("当前道具名称显示")
	当前道具描述显示 = self.get_node("当前道具描述显示")
	玩家属性名称显示 = self.get_node("玩家属性名称显示")
	玩家属性数值显示 = self.get_node("玩家属性数值显示")
	
	背包道具等级框显示集合 = UI内容节点.get_node("背包道具等级框显示集合")
	背包道具图标显示集合 = UI内容节点.get_node("背包道具图标显示集合")
	全局方法.填充节点列表(背包道具等级框显示列表, 1, 栏位页数最大, 背包道具等级框显示集合, "背包道具等级框显示")
	全局方法.填充节点列表(背包道具图标显示列表, 1, 栏位页数最大, 背包道具图标显示集合, "背包道具图标显示")
	
	背包道具图标区域集合 = UI内容节点.get_node("背包道具图标区域集合")
	全局方法.填充节点列表(背包道具图标区域列表, 1, 栏位页数最大, 背包道具图标区域集合, "背包道具图标区域")
	
	背包道具数量显示集合 = self.get_node("背包道具数量显示集合")
	全局方法.填充节点列表(背包道具数量显示列表, 1, 栏位页数最大, 背包道具数量显示集合, "背包道具数量显示")
	
	全局方法.节点列表连接信号(背包道具图标区域列表, "mouse_entered", 鼠标进入背包道具图标区域)
	
	滑动条图片显示 = UI内容节点.get_node("滑动条图片显示")
	滑动条起始连接点 = UI内容节点.get_node("滑动条起始连接点")
	
	if 全局数据_系统.当前查看背包栏位数 > 全局数据_周期对局.背包总栏数:
		全局数据_系统.当前查看背包栏位数 = 1
	
	渲染更新_当前道具信息()
	渲染更新_玩家属性信息() 
	渲染更新_选中指示图片()
	渲染更新_背包道具图标()

func _input(输入事件: InputEvent) -> void:
	if 全局数据_系统.UI输入许可:
		if 输入事件.is_action_pressed("操作→") and 全局数据_系统.当前查看背包栏位数 < 全局数据_周期对局.背包总栏数:
			全局数据_系统.当前查看背包栏位数 += 1
			渲染更新_当前道具信息()
			渲染更新_选中指示图片()
			渲染更新_背包道具图标()
			全局方法.UI输入倒计时启动()
		elif 输入事件.is_action_pressed("操作←") and 全局数据_系统.当前查看背包栏位数 > 1:
			全局数据_系统.当前查看背包栏位数 -= 1
			渲染更新_当前道具信息()
			渲染更新_选中指示图片()
			渲染更新_背包道具图标()
			全局方法.UI输入倒计时启动()
		elif ((输入事件.is_action_pressed("操作↓") or 输入事件.is_action_pressed("鼠标滚轮↓")) and 
		全局数据_系统.当前查看背包栏位数 < 全局数据_周期对局.背包总栏数):
			全局数据_系统.当前查看背包栏位数 += 栏位行数最大
			if 全局数据_系统.当前查看背包栏位数 > 全局数据_周期对局.背包总栏数:
				全局数据_系统.当前查看背包栏位数 = 全局数据_周期对局.背包总栏数
			渲染更新_当前道具信息()
			渲染更新_选中指示图片()
			渲染更新_背包道具图标()
			全局方法.UI输入倒计时启动()
		elif ((输入事件.is_action_pressed("操作↑") or 输入事件.is_action_pressed("鼠标滚轮↑")) and
		 全局数据_系统.当前查看背包栏位数 > 1):
			全局数据_系统.当前查看背包栏位数 -= 栏位行数最大
			if 全局数据_系统.当前查看背包栏位数 < 1:
				全局数据_系统.当前查看背包栏位数 = 1
			渲染更新_当前道具信息()
			渲染更新_选中指示图片()
			渲染更新_背包道具图标()
			全局方法.UI输入倒计时启动()
		elif 输入事件.is_action_pressed("菜单1"):
			关闭背包界面()
			全局方法.UI输入倒计时启动()
		elif 输入事件.is_action_pressed("菜单2"):
			打开技能界面()
			全局方法.UI输入倒计时启动()

func 渲染更新_选中指示图片() -> void:
	var 计算当页栏位数 = 全局数据_系统.当前查看背包栏位数 % 栏位页数最大
	if 计算当页栏位数 == 0:
		计算当页栏位数 = 栏位页数最大
	var 连接点坐标 = 背包道具等级框显示列表[计算当页栏位数].global_position
	选中指示图片.global_position = 连接点坐标
	选中指示图片.visible = true

func 渲染更新_背包道具图标() -> void:
	var 计算当前页数 = ceil(float(全局数据_系统.当前查看背包栏位数) / 栏位页数最大)
	for 索引 in range(1, 背包道具图标显示列表.size()):
		var 遍历等级框显示节点 = 背包道具等级框显示列表[索引]
		var 遍历图标显示节点 = 背包道具图标显示列表[索引]
		var 遍历数量显示节点 = 背包道具数量显示列表[索引]
		var 当前遍历背包栏位数 : int = 索引 + (计算当前页数 - 1) * 栏位页数最大
		if 当前遍历背包栏位数 > 全局数据_周期对局.背包总栏数:
			遍历等级框显示节点.texture = null
			遍历图标显示节点.texture = null
			遍历数量显示节点.text = ""
			continue
		var 遍历道具编号 = 全局数据_周期对局.背包存储数据[当前遍历背包栏位数]
		var 遍历道具等级 = 全局数据库.道具数据库[遍历道具编号]["道具等级"]
		var 拼接等级框键名 = "展示框_等级%d" % 遍历道具等级
		遍历等级框显示节点.texture = 全局数据库.图片资源预加载数据库[拼接等级框键名]
		var 拼接图标键名 = "道具图标%d" % 遍历道具编号
		遍历图标显示节点.texture = 全局数据库.图片资源预加载数据库[拼接图标键名]
		遍历数量显示节点.text = str(全局数据_周期对局.道具持有数据[遍历道具编号])
	
	var 计算总页数 = ceil(float(全局数据_周期对局.背包总栏数) / 栏位页数最大)
	if 计算总页数 > 1:
		滑动条图片显示.visible = true
		var 翻页比例 = (计算当前页数 - 1) / (计算总页数 - 1)
		var 滑动条长度 = max(滑动条最大移动距离 / 计算总页数, 滑动条最小长度)
		var 滑动条实际移动距离 = 滑动条最大移动距离 - 滑动条长度
		var 滑动条位置 = 滑动条起始连接点.position.y + 滑动条实际移动距离 * 翻页比例
		滑动条图片显示.scale.y = 滑动条长度
		滑动条图片显示.position.y = 滑动条位置
	else:
		滑动条图片显示.visible = false

func 渲染更新_当前道具信息() -> void:
	if 全局数据_周期对局.背包总栏数 > 0:
		var 当前查看道具编号 = 全局数据_周期对局.背包存储数据[全局数据_系统.当前查看背包栏位数]
		var 拼接等级框键名 = "展示框_等级%d" % 全局数据库.道具数据库[当前查看道具编号]["道具等级"]
		当前道具等级框显示.texture = 全局数据库.图片资源预加载数据库[拼接等级框键名]
		var 拼接图标键名 = "道具图标%d" % 当前查看道具编号
		当前道具图标显示.texture = 全局数据库.图片资源预加载数据库[拼接图标键名]
		
		var 当前道具数据 = 全局数据库.道具数据库[当前查看道具编号]
		当前道具名称显示.text = 全局方法.解析自定义文本(当前道具数据["道具名称"])
		当前道具描述显示.text = 全局方法.生成道具描述文本(当前查看道具编号)

func 渲染更新_玩家属性信息() -> void:	
	玩家属性名称显示.text = 全局方法.输出玩家属性名称字符串()
	玩家属性数值显示.text = 全局方法.输出玩家属性数值字符串()

func 鼠标进入背包道具图标区域(序号 : int) -> void:
	var 计算当前页数 = ceil(float(全局数据_系统.当前查看背包栏位数) / 栏位页数最大)
	var 尝试计算查看栏位数 = 序号 + (计算当前页数 - 1) * 栏位页数最大
	if 尝试计算查看栏位数 <= 全局数据_周期对局.背包总栏数:
		全局数据_系统.当前查看背包栏位数 = 尝试计算查看栏位数
		渲染更新_当前道具信息()
		渲染更新_选中指示图片()

func 关闭背包界面() -> void:
	全局数据_系统.背包界面已打开 = false
	全局方法.UI输入倒计时启动()
	if 全局数据_系统.奖励界面已打开 == false:
		get_tree().paused = false
	self.queue_free()

func 打开技能界面() -> void:
	if not 全局数据_系统.是否禁用打开技能界面:
		全局方法.打开技能界面()
		self.queue_free()
