func 切换状态处理(新状态名称 : String) -> void:
#切换状态时调用(状态连接检测成功)，根据当前当前状态名称执行退出状态时的效果和新状态名称执行进入状态时的效果
#最后修改状态名和播放新动画
	var 重置普攻次数 : bool = true
	状态改变更新数据(新状态名称)
	#执行退出状态时的效果
	match 当前状态名称:
		"静止":
			pass
	#执行进入状态时的效果
	match 新状态名称:
		"受伤":
			全局方法.播放音频("受伤音效_Li")
			是否进入受伤状态 = false
			跳跃处理()
			状态接口_进入受伤时()
		"静止":
			跳跃次数 = 0
		"移动":
			跳跃次数 = 0
			状态接口_进入移动时()
		"滞空":
			按键控制方向()
			跳跃次数 += 1
		"跳跃":
			按键控制方向()
			跳跃处理()
			跳跃次数 += 1
			新状态名称 = "滞空"
			全局方法.播放音频("基础音效_跳跃")
			全局方法.生成对象池特效("特效_白色椭圆特效", 主节点.global_position)
			状态接口_进入跳跃时()
		"1_游侠_1":
			能量消耗处理(1)
			重置普攻次数 = false
			普攻次数 += 1
			if 普攻次数 == 1:
				按键控制方向()
			状态接口_进入技能时(新状态名称)
		"1_游侠_2":
			重置普攻次数 = false
			状态接口_持续技能时(新状态名称)
		"1_游侠_强化_1":
			能量消耗处理(1)
			重置普攻次数 = false
			普攻次数 += 1
			if 普攻次数 == 1:
				按键控制方向()
			状态接口_进入技能时(新状态名称)
		"1_游侠_强化_2":
			重置普攻次数 = false
			状态接口_持续技能时(新状态名称)
		"2_上挑":
			能量消耗处理(2)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"3_横斩":
			能量消耗处理(3)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"4_刺击":
			能量消耗处理(4)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"5_下劈":
			能量消耗处理(5)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"6_连刃姿态":
			能量消耗处理(6)
			状态接口_进入技能时(新状态名称)
		"7_惊云飞虹":
			能量消耗处理(7)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"8_剑舞旋":
			能量消耗处理(8)
			状态接口_进入技能时(新状态名称)
		"9_绝断式":
			能量消耗处理(9)
			状态接口_进入技能时(新状态名称)
		"10_一线天":
			能量消耗处理(10)
			状态接口_进入技能时(新状态名称)
		"11_裂锋":
			能量消耗处理(11)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"12_治愈喷涌":
			能量消耗处理(12)
			状态接口_进入技能时(新状态名称)
	
	if 重置普攻次数 == true:
		普攻次数 = 0
	当前状态名称 = 新状态名称
	当前动画已结束 = false
	动画模块.play("重置")
	动画模块.advance(0) # 立即触发重置逻辑
	动画模块.play(新状态名称)

