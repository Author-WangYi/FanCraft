@export var 技能内部状态 : int = 0
var 位移倒计时 : float = 0
var 强化倒计时 : float = 0
var 连刃姿态强化时间 : float = 5
var 普攻次数 : int = 0
var 普攻次数最大 : int = 3
var 治愈喷涌治疗量 : float = 10

func _ready() -> void:
	对象资源名称 = "角色_Li"
	默认初始状态 = "静止"
	技能倒计时填充数 = 2
	super()
	技能卡组列表初始化()
	抽取卡组技能(2)
	抽取卡组技能(3)
	抽取卡组技能(4)
	切换状态处理(初始状态名称)
	全局方法.当前波次已结束.connect(技能卡组列表初始化)

func _physics_process(步进时间 : float) -> void:
	super(步进时间)
	#物理帧步进执行，分为状态连接检测和当前状态动作执行两部分
	状态连接检测()
	当前状态动作执行(步进时间)
	if 强化倒计时 > 0:
		强化倒计时 = max(强化倒计时 - 步进时间, 0)

