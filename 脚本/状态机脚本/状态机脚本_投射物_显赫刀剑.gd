extends 基础状态机脚本_投射物

var 飞行倒计时 : float = 0
var 飞行时间 : float = 0.4

func _ready() ->void:
	对象资源名称 = "投射物_显赫刀剑"
	默认初始状态 = "移动"
	技能倒计时填充数 = 2
	super()
	切换状态处理(初始状态名称)

func _physics_process(步进时间 : float) -> void:
	super(步进时间)
	状态连接检测()
	当前状态动作执行(步进时间)
	if 飞行倒计时 > 0:
		飞行倒计时 = max(飞行倒计时 - 步进时间, 0)

func 状态连接检测() -> void:
#物理帧步进调用
	if (
	当前状态名称 == "移动" and
	主节点图块碰撞判断("图块_地图边界墙体") or 飞行倒计时 == 0
	):
		主节点.queue_free()

func 切换状态处理(新状态名称 : String) -> void:
#切换状态时调用(状态连接检测成功)，根据当前当前状态名称执行退出状态时的效果和新状态名称执行进入状态时的效果
#最后修改状态名和播放新动画
	状态改变更新数据(新状态名称)
	#执行退出状态时的效果
	#match 当前状态名称:
	
	#执行进入状态时的效果
	match 新状态名称:
		"移动":
			飞行倒计时 = 飞行时间
			状态接口_进入技能时(新状态名称)
	
	当前状态名称 = 新状态名称
	当前动画已结束 = false
	#动画模块.play("重置")
	#动画模块.advance(0)
	动画模块.play(新状态名称)

func 当前状态动作执行(步进时间 : float) -> void:
#物理帧步进调用
	match 当前状态名称:
		"移动":
			默认加速处理(步进时间)
			移动处理()
