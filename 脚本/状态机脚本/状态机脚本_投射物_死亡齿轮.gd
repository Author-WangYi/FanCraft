extends 基础状态机脚本_投射物

var 飞行倒计时 : float = 0
var 持续倒计时 : float = 0
var 飞行时间 : float = 0.2
var 持续时间 : float = 0.5

@export var 技能内部状态 : int = 0

func _ready() ->void:
	对象资源名称 = "投射物_死亡齿轮"
	默认初始状态 = "飞行"
	技能倒计时填充数 = 2
	super()
	切换状态处理(初始状态名称)

func _physics_process(步进时间 : float) -> void:
	super(步进时间)
	状态连接检测()
	当前状态动作执行(步进时间)

func 状态连接检测() -> void:
#物理帧步进调用
	if (
	当前状态名称 == "飞行" and
	技能内部状态 == 2
	):
		主节点.queue_free()
	elif (
	当前状态名称 == "飞行_强袭" and
	技能内部状态 == 2 and
	与上层对象的距离检测(12, 1)
	):
		主节点.queue_free()

func 切换状态处理(新状态名称 : String) -> void:
#切换状态时调用(状态连接检测成功)，根据当前当前状态名称执行退出状态时的效果和新状态名称执行进入状态时的效果
#最后修改状态名和播放新动画
	状态改变更新数据(新状态名称)
	
	#执行进入状态时的效果
	match 新状态名称:
		"飞行":
			飞行倒计时 = 飞行时间
			技能内部状态 = 0
			状态接口_进入技能时(新状态名称)
		"飞行_强袭":
			飞行倒计时 = 飞行时间
			技能内部状态 = 0
			状态接口_进入技能时(新状态名称)
	
	当前状态名称 = 新状态名称
	当前动画已结束 = false
	#动画模块.play("重置")
	#动画模块.advance(0)
	动画模块.play(新状态名称)

func 当前状态动作执行(步进时间 : float) -> void:
#物理帧步进调用
	match 当前状态名称:
		"飞行":
			match 技能内部状态:
				0:
					if 飞行倒计时 > 0:
						飞行倒计时 = max(飞行倒计时 - 步进时间, 0)
						默认加速处理(步进时间)
						移动处理()
					else:
						持续倒计时 = 持续时间
						技能内部状态 = 1
				1:
					if 持续倒计时 > 0:
						持续倒计时 = max(持续倒计时 - 步进时间, 0)
						默认减速处理(步进时间)
						移动处理()
					else:
						技能内部状态 = 2
		"飞行_强袭":
			match 技能内部状态:
				0:
					if 飞行倒计时 > 0:
						飞行倒计时 = max(飞行倒计时 - 步进时间, 0)
						默认加速处理(步进时间)
						移动处理()
					else:
						持续倒计时 = 持续时间
						技能内部状态 = 1
				1:
					if 持续倒计时 > 0:
						持续倒计时 = max(持续倒计时 - 步进时间, 0)
						默认减速处理(步进时间)
						移动处理()
					else:
						技能内部状态 = 2
				2:
					跟随上层对象(步进时间, 240, Vector2(0, -32))
