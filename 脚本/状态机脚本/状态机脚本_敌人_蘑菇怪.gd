extends 基础状态机脚本_敌人

var 冷却时间最小_技能1 : float = 4
var 冷却时间最大_技能1 : float = 7

func _ready() ->void:
	对象资源名称 = "敌人_蘑菇怪"
	默认初始状态 = "生成"
	技能倒计时填充数 = 2
	super()
	切换状态处理(初始状态名称)

func _physics_process(步进时间 : float) -> void:
	super(步进时间)
	状态连接检测()
	当前状态动作执行(步进时间)

func 状态连接检测() -> void:
#物理帧步进调用
	#region 受伤状态连接
	if 是否进入受伤状态 == true:
		切换状态处理("受伤")
	elif (
	当前状态名称 == "受伤" and
	受伤后硬直倒计时 <= 0
	):
		切换状态处理("移动")
	if (
	生命值 <= 0
	):
		被击败处理()
	#endregion
	
	#region 技能状态连接
	if (
	当前状态名称 == "移动" and
	主节点.is_on_floor() and
	技能倒计时[1] == 0 and
	与玩家角色的距离检测(72, 1)
	):
		切换状态处理("1_技能1")
	elif (
	当前状态名称 == "1_技能1" and
	当前动画已结束
	):
		切换状态处理("移动")
	#endregion
	
	if (
	当前状态名称 == "生成" and
	当前动画已结束
	):
		切换状态处理("移动")

func 切换状态处理(新状态名称 : String) -> void:
#切换状态时调用(状态连接检测成功)，根据当前当前状态名称执行退出状态时的效果和新状态名称执行进入状态时的效果
#最后修改状态名和播放新动画
	状态改变更新数据(新状态名称)
	#执行退出状态时的效果
	#match 当前状态名称:
	
	#执行进入状态时的效果
	match 新状态名称:
		"受伤":
			全局方法.播放音频("基础音效_击中", 0.1, -4)
			是否进入受伤状态 = false
			跳跃处理()
			状态接口_进入受伤时()
		"移动":
			状态接口_进入移动时()
		"1_技能1":
			技能倒计时[1] = randf_range(冷却时间最小_技能1, 冷却时间最大_技能1)
			跳跃处理()
			跟随玩家控制方向()
			状态接口_进入技能时(新状态名称)
	
	当前状态名称 = 新状态名称
	当前动画已结束 = false
	动画模块.play("重置")
	动画模块.advance(0) # 立即触发重置逻辑
	动画模块.play(新状态名称)

func 当前状态动作执行(步进时间 : float) -> void:
#物理帧步进调用
	match 当前状态名称:
		"受伤":
			if 受伤后击退倒计时 > 0:
				默认加速处理(步进时间)
			else:
				默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
		"移动":
			if 隔帧检测_ID异步(20):
				跟随玩家控制方向()
			默认加速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行移动时()
		"1_技能1":
			默认加速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
