extends 基础状态机脚本_角色

@export var 技能内部状态 : int = 0

func _ready() -> void:
	对象资源名称 = "角色_奶龙"
	默认初始状态 = "静止"
	技能倒计时填充数 = 13
	super()
	切换状态处理(初始状态名称)

func _physics_process(步进时间 : float) -> void:
	super(步进时间)
	#物理帧步进执行，分为状态连接检测和当前状态动作执行两部分
	状态连接检测()
	当前状态动作执行(步进时间)

func 状态连接检测() -> void:
#物理帧步进调用
	#region 读取一下需要的检测
	var 获取角色输入许可 = 全局数据_系统.角色输入许可
	var 按住_移动左 : bool = Input.is_action_pressed("移动←")
	var 按住_移动右 : bool = Input.is_action_pressed("移动→")
	var 按下_跳跃 : bool = Input.is_action_just_pressed("跳跃")
	var 按住_技能1 : bool = Input.is_action_pressed("技能1")
	#endregion
	
	#region 受伤状态连接
	if 是否进入受伤状态 == true:
		切换状态处理("受伤")
	elif (
	当前状态名称 == "受伤" and
	受伤后硬直倒计时 <= 0
	):
		切换状态处理("静止")
	if (
	生命值 <= 0
	):
		被击败处理()
	#endregion
	
	#region 基础状态连接（高优先级）
	if (
	(当前状态名称 == "静止" or 当前状态名称 == "移动") and
	not 主节点落地判断()
	):
		切换状态处理("滞空")
	#endregion
	
	#region 技能状态连接
	var 状态分类检测结果 = 轮询状态分类检测()
	var 技能条件检测结果 = 轮询技能条件检测()
	#--1
	if (
	获取角色输入许可 and
	"地面" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 1
	):
		切换状态处理("1_今夜星光闪闪_1")
	elif (
	获取角色输入许可 and
	当前状态名称 == "1_今夜星光闪闪_1" and
	按住_技能1 and
	弱中断检测() 
	):
		切换状态处理("1_今夜星光闪闪_2")
	elif (
	(当前状态名称 == "1_今夜星光闪闪_1" or 当前状态名称 == "1_今夜星光闪闪_2") and
	当前动画已结束
	):
		切换状态处理("静止")
	
	#--2
	elif (
	获取角色输入许可 and
	"地面" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 2
	):
		切换状态处理("2_吐火焰")
	elif (
	获取角色输入许可 and
	"技能" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 2 and
	弱中断检测()
	):
		切换状态处理("2_吐火焰")
	elif (
	当前状态名称 == "2_吐火焰" and
	当前动画已结束
	):
		切换状态处理("静止")
	
	#--3
	elif (
	获取角色输入许可 and
	"地面" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 3
	):
		切换状态处理("3_吐火焰.强袭")
	elif (
	获取角色输入许可 and
	"技能" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 3 and
	强中断检测()
	):
		切换状态处理("3_吐火焰.强袭")
	elif (
	(当前状态名称 == "3_吐火焰.强袭") and
	当前动画已结束
	):
		切换状态处理("静止")
	
	#--4
	elif (
	获取角色输入许可 and
	"地面" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 4
	):
		切换状态处理("4_举高高")
	elif (
	获取角色输入许可 and
	"普攻" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 4 and
	强中断检测()
	):
		切换状态处理("4_举高高")
	elif (
	获取角色输入许可 and
	"技能" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 4 and
	弱中断检测()
	):
		切换状态处理("4_举高高")
	elif (
	(当前状态名称 == "4_举高高") and
	当前动画已结束
	):
		切换状态处理("静止")
	
	#--5
	elif (
	获取角色输入许可 and
	"地面" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 5
	):
		切换状态处理("5_无双大黄瓜")
	elif (
	获取角色输入许可 and
	"普攻" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 5 and
	弱中断检测()
	):
		切换状态处理("5_无双大黄瓜")
	elif (
	(当前状态名称 == "5_无双大黄瓜") and
	当前动画已结束
	):
		切换状态处理("静止")
	
	#--6
	elif (
	获取角色输入许可 and
	"地面" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 6
	):
		切换状态处理("6_沙防掩意手")
	elif (
	获取角色输入许可 and
	"技能" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 6 and
	弱中断检测()
	):
		切换状态处理("6_沙防掩意手")
	elif (
	(当前状态名称 == "6_沙防掩意手") and
	当前动画已结束
	):
		切换状态处理("静止")
	
	#--7
	elif (
	获取角色输入许可 and
	"地面" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 7
	):
		切换状态处理("7_大吼一声猛扑过去")
	elif (
	获取角色输入许可 and
	"技能" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 7 and
	弱中断检测()
	):
		切换状态处理("7_大吼一声猛扑过去")
	elif (
	(当前状态名称 == "7_大吼一声猛扑过去") and
	当前动画已结束
	):
		切换状态处理("静止")
	
	#--8
	elif (
	获取角色输入许可 and
	"地面" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 8
	):
		切换状态处理("8_奶龙回旋")
	elif (
	获取角色输入许可 and
	"普攻" in 状态分类检测结果 and
	技能条件检测结果["技能编号"] == 8 and
	弱中断检测()
	):
		切换状态处理("8_奶龙回旋")
	elif (
	(当前状态名称 == "8_奶龙回旋") and
	当前动画已结束
	):
		切换状态处理("静止")
	
	#endregion
	
	#region 基础状态连接
	if (
	获取角色输入许可 and
	(当前状态名称 == "静止" or 当前状态名称 == "移动" or 当前状态名称 == "滞空") and
	按下_跳跃 and 
	跳跃次数 < 跳跃次数最大
	):
		切换状态处理("跳跃")
	elif (
	获取角色输入许可 and
	当前状态名称 == "静止" and
	(按住_移动左 or 按住_移动右)
	):
		切换状态处理("移动")
	elif (
	当前状态名称 == "移动" and
	(not 按住_移动左 and not 按住_移动右)
	):
		切换状态处理("静止")
	elif (
	当前状态名称 == "滞空" and
	主节点落地判断()
	):
		if (按住_移动左 or 按住_移动右):
			切换状态处理("移动")
		else:
			切换状态处理("静止")
	#endregion

func 切换状态处理(新状态名称 : String) -> void:
#切换状态时调用(状态连接检测成功)，根据当前当前状态名称执行退出状态时的效果和新状态名称执行进入状态时的效果
#最后修改状态名和播放新动画
	状态改变更新数据(新状态名称)
	#执行退出状态时的效果
	#match 当前状态名称:
	
	#执行进入状态时的效果
	match 新状态名称:
		"受伤":
			全局方法.播放音频("受伤音效_奶龙")
			是否进入受伤状态 = false
			跳跃处理()
			状态接口_进入受伤时()
		"静止":
			跳跃次数 = 0
		"移动":
			跳跃次数 = 0
			状态接口_进入移动时()
		"滞空":
			按键控制方向()
			跳跃次数 += 1
		"跳跃":
			按键控制方向()
			跳跃处理()
			跳跃次数 += 1
			全局方法.播放音频("基础音效_跳跃")
			全局方法.生成对象池特效("特效_白色椭圆特效", 主节点.global_position)
			新状态名称 = "滞空"
			状态接口_进入跳跃时()
		"1_今夜星光闪闪_1":
			技能倒计时开始(1)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"1_今夜星光闪闪_2":
			按键控制方向()
			状态接口_持续技能时(新状态名称)
		"2_吐火焰":
			技能倒计时开始(2)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"3_吐火焰.强袭":
			技能倒计时开始(3)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"4_举高高":
			技能倒计时开始(4)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"5_无双大黄瓜":
			技能倒计时开始(5)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"6_沙防掩意手":
			技能倒计时开始(6)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"7_大吼一声猛扑过去":
			技能倒计时开始(7)
			状态接口_进入技能时(新状态名称)
		"8_奶龙回旋":
			技能倒计时开始(8)
			按键控制方向()
			跳跃处理()
			状态接口_进入技能时(新状态名称)
	
	当前状态名称 = 新状态名称
	当前动画已结束 = false
	动画模块.play("重置")
	动画模块.advance(0) # 立即触发重置逻辑
	动画模块.play(新状态名称)

func 当前状态动作执行(步进时间 : float) -> void:
#物理帧步进调用
	match 当前状态名称:
		"受伤":
			if 受伤后击退倒计时 > 0:
				默认加速处理(步进时间)
			else:
				默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
		"静止":
			默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
		"移动":
			按键控制方向()
			自由加减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行移动时()
		"滞空":
			自由加减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
		"1_今夜星光闪闪_1":
			默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
		"1_今夜星光闪闪_2":
			默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
		"2_吐火焰":
			默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
		"3_吐火焰.强袭":
			自由加减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
		"4_举高高":
			默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
		"5_无双大黄瓜":
			默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
		"6_沙防掩意手":
			默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
		"7_大吼一声猛扑过去":
			if 技能内部状态 == 0:
				默认减速处理(步进时间)
			elif 技能内部状态 == 1:
				默认加速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
		"8_奶龙回旋":
			默认加速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
