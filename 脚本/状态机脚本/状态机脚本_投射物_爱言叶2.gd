extends 基础状态机脚本_投射物

var 穿透倒计时 : float = -1
var 穿透时间 : float = 0.15
var 确认碰撞 : bool = false

func _ready() ->void:
	对象资源名称 = "投射物_爱言叶2"
	默认初始状态 = "投掷"
	技能倒计时填充数 = 2
	super()
	切换状态处理(初始状态名称)

func _physics_process(步进时间 : float) -> void:
	super(步进时间)
	状态连接检测()
	当前状态动作执行(步进时间)
	if 穿透倒计时 > 0:
		穿透倒计时 = max(穿透倒计时 - 步进时间, 0)

func 状态连接检测() -> void:
#物理帧步进调用
	if (
	(当前状态名称 == "投掷" or 当前状态名称 == "投掷_强化") and
	(主节点图块碰撞判断("图块_地图边界墙体") or 穿透倒计时 == 0)
	):
		主节点.queue_free()
	elif (
	当前状态名称 == "投掷_强化" and
	确认碰撞
	):
		切换状态处理("投掷_强化_爆炸")
	elif (
	当前状态名称 == "投掷_强化_爆炸" and
	当前动画已结束
	):
		主节点.queue_free()

func 切换状态处理(新状态名称 : String) -> void:
#切换状态时调用(状态连接检测成功)，根据当前当前状态名称执行退出状态时的效果和新状态名称执行进入状态时的效果
#最后修改状态名和播放新动画
	状态改变更新数据(新状态名称)
	#执行退出状态时的效果
	#match 当前状态名称:
	
	#执行进入状态时的效果
	match 新状态名称:
		"投掷":
			状态接口_进入技能时(新状态名称)
		"投掷_强化":
			状态接口_进入技能时(新状态名称)
		"投掷_强化_爆炸":
			状态接口_持续技能时(新状态名称)
	
	当前状态名称 = 新状态名称
	当前动画已结束 = false
	动画模块.play("重置")
	动画模块.advance(0)
	动画模块.play(新状态名称)

func 当前状态动作执行(步进时间 : float) -> void:
#物理帧步进调用
	match 当前状态名称:
		"投掷":
			默认加速处理(步进时间)
			重力处理(步进时间)
			移动处理()
		"投掷_强化":
			默认加速处理(步进时间)
			重力处理(步进时间)
			移动处理()
		"投掷_强化_爆炸":
			pass

func 检测到受伤区域进入(来源区域 : Area2D) -> void:
	super(来源区域)
	if 穿透倒计时 < 0:
		穿透倒计时 = 穿透时间

func 仅检测型_检测到受伤区域进入(_来源区域 : Area2D) -> void:
	#这种特殊的攻击判定不会调用攻击受伤逻辑，仅仅是尝试去检查能否碰撞
	确认碰撞 = true
