extends 基础状态机脚本_投射物

var 剩余爆炸次数 : int = 1
var 爆炸倒计时 : float = -1
var 爆炸等待时间 : float = 0.5

func _ready() ->void:
	对象资源名称 = "投射物_爱言叶4"
	默认初始状态 = "投掷"
	技能倒计时填充数 = 2
	super()
	切换状态处理(初始状态名称)

func _physics_process(步进时间 : float) -> void:
	super(步进时间)
	状态连接检测()
	当前状态动作执行(步进时间)

func 状态连接检测() -> void:
#物理帧步进调用
	if (
	当前状态名称 == "投掷" and
	主节点图块碰撞判断("图块_地图边界墙体")
	):
		主节点.queue_free()
	elif (
	当前状态名称 == "投掷" and
	主节点.is_on_floor()
	):
		切换状态处理("落地")
	elif (
	当前状态名称 == "落地" and
	爆炸倒计时 == 0
	):
		切换状态处理("爆炸")
	elif (
	当前状态名称 == "爆炸" and
	当前动画已结束
	):
		主节点.queue_free()

func 切换状态处理(新状态名称 : String) -> void:
#切换状态时调用(状态连接检测成功)，根据当前当前状态名称执行退出状态时的效果和新状态名称执行进入状态时的效果
#最后修改状态名和播放新动画
	状态改变更新数据(新状态名称)
	#执行退出状态时的效果
	#match 当前状态名称:
	
	#执行进入状态时的效果
	match 新状态名称:
		"投掷":
			水平最大移动 *= randf_range(0.8, 1)
			跳跃处理()
			状态接口_进入技能时(新状态名称)
		"投掷_反向":
			水平最大移动 *= randf_range(0.8, 1)
			跳跃处理()
			对象内容节点.scale.x *= -1
			新状态名称 = "投掷"
			状态接口_进入技能时(新状态名称)
		"落地":
			爆炸倒计时 = 爆炸等待时间
			状态接口_持续技能时(新状态名称)
		"爆炸":
			状态接口_持续技能时(新状态名称)
	
	当前状态名称 = 新状态名称
	当前动画已结束 = false
	动画模块.play("重置")
	动画模块.advance(0)
	动画模块.play(新状态名称)

func 当前状态动作执行(步进时间 : float) -> void:
#物理帧步进调用
	match 当前状态名称:
		"投掷":
			默认加速处理(步进时间)
			重力处理(步进时间)
			移动处理()
		"落地":
			if 爆炸倒计时 > 0:
				爆炸倒计时 -= 步进时间
				if 爆炸倒计时 < 0:
					爆炸倒计时 = 0
			默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
		"爆炸":
			pass

func 爆炸处理() -> void:
	剩余爆炸次数 -= 1
	if 剩余爆炸次数 > 0:
		var 生成对象的状态机模块1 = 对象生成投射物("投射物_爱言叶4", "投掷")
		var 生成对象的状态机模块2 = 对象生成投射物("投射物_爱言叶4", "投掷_反向")
		生成对象的状态机模块1.剩余爆炸次数 = 剩余爆炸次数
		生成对象的状态机模块2.剩余爆炸次数 = 剩余爆炸次数
