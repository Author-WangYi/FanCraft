func 切换状态处理(新状态名称 : String) -> void:
#切换状态时调用(状态连接检测成功)，根据当前当前状态名称执行退出状态时的效果和新状态名称执行进入状态时的效果
#最后修改状态名和播放新动画
	状态改变更新数据(新状态名称)
	#执行退出状态时的效果
	#match 当前状态名称:
	
	#执行进入状态时的效果
	match 新状态名称:
		"受伤":
			全局方法.播放音频("受伤音效_长崎素世")
			是否进入受伤状态 = false
			跳跃处理()
			状态接口_进入受伤时()
		"静止":
			跳跃次数 = 0
		"移动":
			跳跃次数 = 0
			状态接口_进入移动时()
		"滞空":
			按键控制方向()
			跳跃次数 += 1
		"跳跃":
			按键控制方向()
			跳跃处理()
			跳跃次数 += 1
			全局方法.播放音频("基础音效_跳跃")
			全局方法.生成对象池特效("特效_白色椭圆特效", 主节点.global_position)
			新状态名称 = "滞空"
			状态接口_进入跳跃时()
		"1_贝斯手的幸福论_1":
			技能倒计时开始(1)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"1_贝斯手的幸福论_2":
			状态接口_持续技能时(新状态名称)
		"1_贝斯手的幸福论_3":
			位移倒计时 = 0.1
			状态接口_持续技能时(新状态名称)
		"2_啊岚刀一直切":
			技能倒计时开始(2)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"3_无双大黄瓜":
			技能倒计时开始(3)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"4_无双大黄瓜.强袭":
			技能倒计时开始(4)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"5_一刀一刀燃烧刀":
			技能倒计时开始(5)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"6_一刀一刀燃烧刀.强袭":
			技能倒计时开始(6)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"7_显赫刀剑":
			技能倒计时开始(7)
			状态接口_进入技能时(新状态名称)
		"8_影分身十字斩":
			技能倒计时开始(8)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"9_香飘飘热饮":
			技能倒计时开始(9)
			状态接口_进入技能时(新状态名称)
		"10_上挑":
			技能倒计时开始(10)
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"11_崩山击_1":
			技能倒计时开始(11)
			跳跃处理()
			按键控制方向()
			状态接口_进入技能时(新状态名称)
		"11_崩山击_2":
			状态接口_持续技能时(新状态名称)
		"12_寒泥挪燕步":
			技能倒计时开始(12)
			状态接口_进入技能时(新状态名称)
	
	当前状态名称 = 新状态名称
	当前动画已结束 = false
	动画模块.play("重置")
	动画模块.advance(0) # 立即触发重置逻辑
	动画模块.play(新状态名称)

func 当前状态动作执行(步进时间 : float) -> void:
#物理帧步进调用
	match 当前状态名称:
		"受伤":
			if 受伤后击退倒计时 > 0:
				默认加速处理(步进时间)
			else:
				默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
		"静止":
			默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
		"移动":
			按键控制方向()
			自由加减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行移动时()
		"滞空":
			自由加减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
		"1_贝斯手的幸福论_1":
			自由加减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
		"1_贝斯手的幸福论_2":
			自由加减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
		"1_贝斯手的幸福论_3":
			if 位移倒计时 > 0:
				默认加速处理(步进时间)
				重力处理(步进时间)
				移动处理()
				位移倒计时 -= 步进时间
			else:
				默认减速处理(步进时间)
				重力处理(步进时间)
				移动处理()
			状态接口_进行技能时()
		"2_啊岚刀一直切":
			默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
		"3_无双大黄瓜":
			默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
		"4_无双大黄瓜.强袭":
			默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
		"5_一刀一刀燃烧刀":
			默认减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
		"6_一刀一刀燃烧刀.强袭":
			自由加减速处理(步进时间)
			重力处理(步进时间)
			移动处理()
			状态接口_进行技能时()
		"7_显赫刀剑":
			默认减速处理(步进时间)
			重力处理(步进时间)
