extends 基础状态机脚本_角色

var 位移倒计时 : float = 0
var 显赫刀剑数量 : int = 0
var 香飘飘热饮恢复率 : float = 0.3

func _ready() -> void:
	对象资源名称 = "角色_长崎素世"
	默认初始状态 = "静止"
	技能倒计时填充数 = 13
	super()
	切换状态处理(初始状态名称)

func _physics_process(步进时间 : float) -> void:
	super(步进时间)
	#物理帧步进执行，分为状态连接检测和当前状态动作执行两部分
	状态连接检测()
	当前状态动作执行(步进时间)

func 状态连接检测() -> void:
