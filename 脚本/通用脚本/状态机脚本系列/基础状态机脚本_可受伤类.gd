extends 基础状态机脚本_可攻击类

class_name 基础状态机脚本_可受伤类

var 生命值最大 : float = 1:
	set(新值):
		生命值最大 = 新值
		if 生命值 > 生命值最大:
			生命值 = 生命值最大
var 生命值 : float = 1:
	set(新值):
		if 新值 > 生命值最大:
			生命值 = 生命值最大
		else:
			生命值 = 新值

#region 受伤相关变量
@export var 霸体持续中 : bool = false
var 无敌倒计时 : float = 0
var 受伤后击退倒计时 : float = 0
var 受伤后硬直倒计时 : float = 0

var 接受攻击数据字典 : Dictionary = {}
var 是否结算受伤 : bool = false
var 是否进入受伤状态 : bool = false
var 记录接受伤害 : float = 0
#endregion

func _physics_process(步进时间 : float) -> void:
	super(步进时间)
	if 无敌倒计时 > 0.0:
		无敌倒计时 = max(无敌倒计时 - 步进时间, 0)
	if 受伤后击退倒计时 > 0.0:
		受伤后击退倒计时 = max(受伤后击退倒计时 - 步进时间, 0)
	if 受伤后硬直倒计时 > 0.0:
		受伤后硬直倒计时 = max(受伤后硬直倒计时 - 步进时间, 0)

func 检测到攻击区域进入(_来源区域 : Area2D) -> void:
	pass

func 生成结算接受攻击数据() -> Dictionary:
	var 生成字典 : Dictionary
	var 正击飞速度最大 : float = 0
	var 负击飞速度最大 : float = 0
	for 遍历攻击方ID in 接受攻击数据字典:
		for 遍历键 in 接受攻击数据字典[遍历攻击方ID]:
			match 遍历键:
				"基础伤害":
					生成字典[遍历键] = 生成字典.get(遍历键, 0) + 接受攻击数据字典[遍历攻击方ID][遍历键]
				"物理伤害":
					生成字典[遍历键] = 生成字典.get(遍历键, 0) + 接受攻击数据字典[遍历攻击方ID][遍历键]
				"魔法伤害":
					生成字典[遍历键] = 生成字典.get(遍历键, 0) + 接受攻击数据字典[遍历攻击方ID][遍历键]
				"击飞速度":
					var 遍历击飞速度 = 接受攻击数据字典[遍历攻击方ID][遍历键]
					if 遍历击飞速度 >= 0:
						正击飞速度最大 = max(正击飞速度最大, 遍历击飞速度)
					else:
						负击飞速度最大 = min(负击飞速度最大, 遍历击飞速度)
				"击退速度":
					生成字典[遍历键] = 生成字典.get(遍历键, 0) + 接受攻击数据字典[遍历攻击方ID][遍历键]
				"击退时间":
					生成字典[遍历键] = max(生成字典.get(遍历键, 0), 接受攻击数据字典[遍历攻击方ID][遍历键])
				"硬直时间":
					生成字典[遍历键] = max(生成字典.get(遍历键, 0), 接受攻击数据字典[遍历攻击方ID][遍历键])
				"无敌时间":
					生成字典[遍历键] = max(生成字典.get(遍历键, 0), 接受攻击数据字典[遍历攻击方ID][遍历键])
				_:
					生成字典.get_or_add(遍历键, []).append(接受攻击数据字典[遍历攻击方ID][遍历键])
	生成字典["击飞速度"] = 正击飞速度最大 + 负击飞速度最大
	接受攻击数据字典 = {}
	return 生成字典

func 结算受伤() -> void:
	是否结算受伤 = false
	var 结算接受攻击数据 : Dictionary = 生成结算接受攻击数据()
	var 接受伤害 = 0
	接受伤害 += 结算接受攻击数据.get_or_add("基础伤害", 0)
	接受伤害 += 结算接受攻击数据.get_or_add("物理伤害", 0)
	接受伤害 += 结算接受攻击数据.get_or_add("魔法伤害", 0)
	if self.is_in_group("对象类型_角色"):
		接受伤害 = 全局方法.防御力修正伤害(接受伤害)
	生命值 = 生命值 - 接受伤害
	记录接受伤害 = 接受伤害
	#无论是不是霸体，无敌倒计时都必须启动
	无敌倒计时 = 结算接受攻击数据.get_or_add("无敌时间", 0)
	if 霸体持续中 == false:
		是否进入受伤状态 = true
		起始跳跃速度 = 结算接受攻击数据.get_or_add("击飞速度", 0)	
		水平最大移动 = 结算接受攻击数据.get_or_add("击退速度", 0)
		受伤后击退倒计时 = 结算接受攻击数据.get_or_add("击退时间", 0)
		受伤后硬直倒计时 = 结算接受攻击数据.get_or_add("硬直时间", 0)
	#print("【结算受伤】对象名", 对象资源名称, "，接受伤害：", 接受伤害,"，起始跳跃速度：", 起始跳跃速度, "，水平最大移动：", 水平最大移动,"，受伤后击退倒计时：", 受伤后击退倒计时, "，受伤后硬直倒计时：", 受伤后硬直倒计时)
	接口_结算受伤时()

func 接口_结算受伤时() -> void:  #这里留空，防止报错，敌人和角色一般不可能在这个接口有相同的代码
	if 85 in 道具持有数据:
		var 随机数 = randf()
		if 随机数 <= 道具静态特殊变量数据库["道具85_触发概率数"]:
			if 霸体持续中 == false:
				起始跳跃速度 *= 1 + 道具静态特殊变量数据库["道具85_效果增益比例"]
				受伤后硬直倒计时 *= 1 + 道具静态特殊变量数据库["道具85_效果增益比例"]
