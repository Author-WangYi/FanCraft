			全局动态变量字典["道具54_增加物理攻击数值统计"] = 道具静态特殊变量数据库["道具54_增加物理攻击数值"]
			
			全局方法.修改玩家属性值("玩家属性_魔法攻击", 2, (-全局动态变量字典["道具54_增加魔法攻击数值统计"] + 道具静态特殊变量数据库["道具54_增加魔法攻击数值"]))
			全局动态变量字典["道具54_增加魔法攻击数值统计"] = 道具静态特殊变量数据库["道具54_增加魔法攻击数值"]
			
			if 全局动态变量字典["道具54_触发次数统计"] >= 道具静态特殊变量数据库["道具54_减少最大生命值数值最大"]:
				全局方法.修改玩家属性值("玩家属性_最大生命值", 3, 道具静态特殊变量数据库["道具54_减少最大生命值数值最大"])
				全局动态变量字典["道具54_减少最大生命值数值统计"] += 道具静态特殊变量数据库["道具54_减少最大生命值数值最大"]
			else:
				全局方法.修改玩家属性值("玩家属性_最大生命值", 3, 全局动态变量字典["道具54_触发次数统计"])
				全局动态变量字典["道具54_减少最大生命值数值统计"] += 全局动态变量字典["道具54_触发次数统计"]
			
			创建动态变量计时器(
				"道具54_效果计时器", 道具静态特殊变量数据库["道具54_效果时间"], 2,
				func():
					全局方法.修改玩家属性值("玩家属性_物理攻击", 3, 全局动态变量字典["道具54_增加物理攻击数值统计"])
					全局动态变量字典["道具54_增加物理攻击数值统计"] = 0
					全局方法.修改玩家属性值("玩家属性_魔法攻击", 3, 全局动态变量字典["道具54_增加魔法攻击数值统计"])
					全局动态变量字典["道具54_增加魔法攻击数值统计"] = 0
					)
	if 67 in 道具持有数据:
		if "子弹数量" in self:
			var 随机数 = randf()
			if 随机数 <= 道具静态特殊变量数据库["道具67_触发概率值"] * 道具持有数据[67]:
				self.子弹数量 += 道具静态特殊变量数据库["道具67_获得子弹数量"]
	if 70 in 道具持有数据:
		var 随机数 = randf()
		if 随机数 <= 道具静态特殊变量数据库["道具70_触发概率值"]:
			var 符合条件的技能编号列表 : Array
			for 遍历技能编号 in 全局数据_周期对局.技能编号_键位:
				if 遍历技能编号 != 0 and 技能倒计时[遍历技能编号] > 0:
					符合条件的技能编号列表.append(遍历技能编号)
			if 符合条件的技能编号列表.size() > 0:
				var 抽取技能编号 = 符合条件的技能编号列表.pick_random()
				技能倒计时[抽取技能编号] *= 道具静态特殊变量数据库["道具70_冷却倒计时减少比例"]
	if 90 in 道具持有数据:
		var 随机数 = randf()
		if 随机数 <= 道具静态特殊变量数据库["道具90_触发概率值"]:
			生命值 = min(道具静态特殊变量数据库["道具90_生命值修改目标值"], 生命值最大)

