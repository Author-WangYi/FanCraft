extends 基础状态机脚本_可受伤类

class_name 基础状态机脚本_角色

var 该角色名称 : String
var 该角色技能背包类型 : int

var 跳跃次数最大 : float = 1
var 跳跃次数 : float = 0
var 能量最大 : float = 5:
	set(新值):
		能量最大 = 新值
		if 能量 > 能量最大:
			能量 = 能量最大
var 能量 : float = 0:
	set(新值):
		if 新值 > 能量最大:
			能量 = 能量最大
		else:
			能量 = 新值
var 技能卡组列表 : PackedInt32Array = []

@export var 强中断时间 : float = 1
@export var 弱中断时间 : float = 1
@export var 当前技能生命窃取次数 : float = 0
#该变量通过动画模块上的时间轴来设定，敌人触发脚本后给它减1，所以设定几点就能触发几次生命窃取，一般都是1
@export var 当前技能命中获得能量合计 : float = 0
var 生命再生倒计时 : float = 0


var 该角色技能数据库 : Dictionary
var 状态数据库_当前状态标签次级索引 : Dictionary = {}
#根据状态数据库的数据自动填充，这是一个次级索引，方便角色的连接判断
#为了查询的性能，这个次级索引的值不是数组而是字典
var 技能数据库_技能键位次级索引 : Dictionary = {}

func _ready() ->void:
	super()
	var 该角色编号 = 全局数据库.角色数据库_对象资源名称次级索引[对象资源名称][0]
	该角色名称 = 全局数据库.角色数据库[该角色编号]["角色名称"]
	该角色技能数据库 = 全局数据库.技能数据库["技能数据库_" + 该角色名称]
	该角色技能背包类型 = 全局数据库.角色数据库[该角色编号]["角色技能背包类型"]
	状态数据库_当前状态标签次级索引 = 全局数据库.状态数据库_当前状态标签次级索引["状态数据库_" + 对象资源名称]
	技能数据库_技能键位次级索引 = 全局数据库.技能数据库_技能键位次级索引["技能数据库_" + 该角色名称]
	生命再生倒计时 = 全局数据_环境.生命再生间隔时间
	
	全局数据_系统.当前游玩角色实例 = 主节点
	全局数据_系统.当前游玩角色状态机模块实例 = self
	全局方法.玩家角色实例就绪.emit()
	
	生成时变量同步()
	接口_生成时()

func _physics_process(步进时间 : float) -> void:
	super(步进时间)
	生命再生帧处理(步进时间)

func 检测到受伤区域进入(来源区域 : Area2D) -> void:
	super(来源区域)
	if 当前技能生命窃取次数 > 0:
		var 生命窃取属性值 = 全局数据_周期对局.玩家属性_生命窃取
		if 生命窃取属性值 > 0:
			var 计算恢复值 = 0
			var 生命窃取每阶段值 = 全局数据_环境.生命窃取每阶段值
			var 生命窃取每阶段恢复概率值 = 全局数据_环境.生命窃取每阶段恢复概率值
			while 生命窃取属性值 > 0:
				var 本阶段生命窃取属性值 = min(生命窃取每阶段值, 生命窃取属性值)
				var 本阶段恢复概率值 = 本阶段生命窃取属性值 / 生命窃取每阶段值 * 生命窃取每阶段恢复概率值
				var 随机数 = randf()
				if 随机数 <= 本阶段恢复概率值:
					计算恢复值 += 1
				生命窃取属性值 -= 生命窃取每阶段值
			上层状态机模块.生命值 = min(上层状态机模块.生命值 + 计算恢复值, 上层状态机模块.生命值最大)
		当前技能生命窃取次数 -= 1
	
	if 当前技能命中获得能量合计 > 0:
		上层状态机模块.能量 += 1
		当前技能命中获得能量合计 -= 1

func 结算受伤() -> void:
	super()
	全局方法.屏幕抖动(12, 0.2, true)
	全局方法.修改游戏速度(0.1, 0.05)
	全局方法.生成对象池特效("特效_命中2", 连接点字典["命中特效连接点"].global_position)

func 被击败处理() -> void:
	接口_被击败前()
	if 生命值 <= 0:
		全局方法.游戏结束()

func 生成时变量同步() -> void:
	生命值最大 = 全局数据_周期对局.玩家属性_最大生命值
	生命值 = 生命值最大

func 技能卡组列表初始化() -> void:
	技能卡组列表 = []
	var 卡片技能持有数据 = 全局数据_周期对局.卡片技能持有数据
	var 技能持有数据 = 全局数据_周期对局.技能持有数据
	for 遍历技能编号 in 卡片技能持有数据:
		技能持有数据[遍历技能编号] = 卡片技能持有数据[遍历技能编号]
		if 卡片技能持有数据[遍历技能编号] > 0:
			for 循环变量 in range(卡片技能持有数据[遍历技能编号]):
				技能卡组列表.append(遍历技能编号)
	for 遍历索引 in range(全局数据_周期对局.技能编号_键位.size()):
		var 遍历技能编号 = 全局数据_周期对局.技能编号_键位[遍历索引]
		if 遍历技能编号 == 0 or 卡片技能持有数据[遍历技能编号] == -999:
			continue
		全局数据_周期对局.技能编号_键位[遍历索引] = 0

func 抽取卡组技能(目标键位 : int) -> void:
	全局数据_周期对局.技能编号_键位[目标键位] = 0
	# 1. 找出所有符合键位要求的技能在卡组中的索引（Index）
	var 可选卡组中索引列表 = []
	for 遍历变量 in range(技能卡组列表.size()):
		var 遍历技能编号 = 技能卡组列表[遍历变量]
		if 遍历技能编号 in 技能数据库_技能键位次级索引[目标键位]:
			可选卡组中索引列表.append(遍历变量)
	# 2. 如果没有符合条件的技能
	if 可选卡组中索引列表.is_empty():
		return
	# 3. 从索引列表中随机选一个索引
	var 随机索引 = 可选卡组中索引列表[randi() % 可选卡组中索引列表.size()]
	var 抽中的技能编号 = 技能卡组列表[随机索引]
	# 4. 从卡组中移除（严谨操作：根据索引移除）
	技能卡组列表.remove_at(随机索引)
	全局数据_周期对局.技能编号_键位[目标键位] = 抽中的技能编号
	全局数据_周期对局.技能持有数据[抽中的技能编号] -= 1

func 状态分类检测(状态名 : String, 状态分类 : String) -> bool:
	if 状态数据库_当前状态标签次级索引.has(状态分类):
		if 状态数据库_当前状态标签次级索引[状态分类].has(状态名):
			return true
	return false

