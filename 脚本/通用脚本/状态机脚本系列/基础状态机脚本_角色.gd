func 状态接口_进入技能时(状态名 : String) -> void:  #开始技能的第一段动画的第一帧执行(比如有的道具根据释放技能次数给效果)
	if 20 in 道具持有数据:  #第一段技能符合速度要求，则后续都符合要求
		if abs(主节点.velocity.x) >= 道具静态特殊变量数据库["道具20_满足条件速度最小值"]:
			动态变量字典["道具20_条件检查"] = true
		else:
			动态变量字典["道具20_条件检查"] = false
	if 69 in 道具持有数据:
		if "子弹数量" in self:
			if not 状态分类检测(状态名, "普攻"):
				self.子弹数量 += 道具静态特殊变量数据库["道具69_获得子弹数量"]
	if 80 in 道具持有数据:
		if not 状态分类检测(状态名, "普攻"):
			if not 全局动态变量字典.has("道具80_累加次数统计"):
				全局动态变量字典["道具80_累加次数统计"] = 0
				全局动态变量字典["道具80_增加物理攻击数值统计"] = 0
				全局动态变量字典["道具80_增加魔法攻击数值统计"] = 0
			
			if 全局动态变量字典["道具80_累加次数统计"] < 道具静态特殊变量数据库["道具80_累加次数最大"]:
				全局动态变量字典["道具80_累加次数统计"] += 1
				全局方法.修改玩家属性值("玩家属性_物理攻击", 2, 道具静态特殊变量数据库["道具80_增加物理攻击数值"])
				全局动态变量字典["道具80_增加物理攻击数值统计"] += 道具静态特殊变量数据库["道具80_增加物理攻击数值"]
				全局方法.修改玩家属性值("玩家属性_魔法攻击", 2, 道具静态特殊变量数据库["道具80_增加魔法攻击数值"])
				全局动态变量字典["道具80_增加魔法攻击数值统计"] += 道具静态特殊变量数据库["道具80_增加魔法攻击数值"]
			
			创建动态变量计时器(
				"道具80_效果计时器", 道具静态特殊变量数据库["道具80_效果时间"], 1,
				func():
					全局动态变量字典["道具80_累加次数统计"] = 0
					全局方法.修改玩家属性值("玩家属性_物理攻击", 3, 全局动态变量字典["道具80_增加物理攻击数值统计"])
					全局动态变量字典["道具80_增加物理攻击数值统计"] = 0
					全局方法.修改玩家属性值("玩家属性_魔法攻击", 3, 全局动态变量字典["道具80_增加魔法攻击数值统计"])
					全局动态变量字典["道具80_增加魔法攻击数值统计"] = 0
					)
	
	状态接口_持续技能时(状态名)

func 状态接口_持续技能时(状态名 : String) -> void:  #开始技能的每段动画的第一帧执行(道具给技能加伤，但有的技能是分段状态的，开启新的一段后数据全都刷新了，需要再执行一次)
	var 技能伤害比例 : float = 1
	
	if 20 in 道具持有数据:
		if 动态变量字典["道具20_条件检查"] == true:
			技能伤害比例 += 道具静态特殊变量数据库["道具20_伤害加成"]
	if 87 in 道具持有数据:
		if 技能卡组列表.size() > 0:
			if not 状态分类检测(状态名, "普攻"):
				var 计算伤害加成 = 技能卡组列表.size() * 道具静态特殊变量数据库["道具87_伤害加成比例值"]
				技能伤害比例 += 计算伤害加成
	
	if 技能伤害比例 != 1:
		当前技能基础伤害 *= 技能伤害比例
		当前技能物理伤害 *= 技能伤害比例
		当前技能魔法伤害 *= 技能伤害比例

