func 强中断检测() -> bool:
	return 强中断时间 <= 全局数据_周期对局.玩家属性_强中断阈值

func 弱中断检测() -> bool:
	return 弱中断时间 <= 全局数据_周期对局.玩家属性_弱中断阈值

func 技能倒计时开始(技能编号 : int) -> void:  #只适用于角色对象
	var 尝试获取冷却时间 = 该角色技能数据库[技能编号]["冷却时间"]
	if not is_same(尝试获取冷却时间, ""):
		技能倒计时[技能编号] = 尝试获取冷却时间

func 能量消耗处理(技能编号 : int) -> void:
	var 尝试获取能量消耗 = 该角色技能数据库[技能编号]["技能消耗"]
	if not is_same(尝试获取能量消耗, ""):
		能量 -= 尝试获取能量消耗

func 生命再生帧处理(步进时间 : float) -> void:
	if 生命再生倒计时 > 0:
		生命再生倒计时 -= 步进时间
	else:
		生命再生倒计时 = 全局数据_环境.生命再生间隔时间
		var 生命再生属性值 = 全局数据_周期对局.玩家属性_生命再生
		if 生命再生属性值 > 0:
			var 计算恢复值 = 0
			var 生命再生每阶段值 = 全局数据_环境.生命再生每阶段值
			var 生命再生每阶段恢复概率值 = 全局数据_环境.生命再生每阶段恢复概率值
			while 生命再生属性值 > 0:
				var 本阶段生命再生属性值 = min(生命再生每阶段值, 生命再生属性值)
				var 本阶段恢复概率值 = 本阶段生命再生属性值 / 生命再生每阶段值 * 生命再生每阶段恢复概率值
				var 随机数 = randf()
				if 随机数 <= 本阶段恢复概率值:
					计算恢复值 += 1
				生命再生属性值 -= 生命再生每阶段值
			生命值 = min(生命值 + 计算恢复值, 生命值最大)

#region 加减速方法，只选择一个
func 自由加减速处理(步进时间 : float) -> void:
	var 按住_移动左 : bool = Input.is_action_pressed("移动←")
	var 按住_移动右 : bool = Input.is_action_pressed("移动→")
	if 按住_移动右:
		# 逻辑：如果向右超速，则使用减速步进
		var 应用加减速度 = 水平加速
		if 主节点.velocity.x > 水平最大移动:
			应用加减速度 = 水平减速
		主节点.velocity.x = move_toward(主节点.velocity.x, 水平最大移动, 应用加减速度 * 步进时间)
	elif 按住_移动左:
		# 逻辑：如果向左超速（速度小于负的最大移动），则使用减速步进
		var 应用加减速度 = 水平加速
		if 主节点.velocity.x < 水平最大移动 * -1:
			应用加减速度 = 水平减速
		主节点.velocity.x = move_toward(主节点.velocity.x, 水平最大移动 * -1, 应用加减速度 * 步进时间)
	else:
		主节点.velocity.x = move_toward(主节点.velocity.x, 0, 水平减速 * 步进时间)
#endregion

func 按键控制方向() -> void:
#该方法不需要传入步进时间，也可以用于进入状态或退出状态那一帧，应用一次
	var 按住_移动右 : bool = Input.is_action_pressed("移动→")
	var 按住_移动左 : bool = Input.is_action_pressed("移动←")
	if 按住_移动右 == true:
		对象内容节点.scale.x = 1
	elif 按住_移动左 == true:
		对象内容节点.scale.x = -1

func 按键控制方向_可锁定() -> void:
	var 按住_移动下 : bool = Input.is_action_pressed("移动↓")
	if 按住_移动下 == true:
		return
	var 按住_移动右 : bool = Input.is_action_pressed("移动→")
	if 按住_移动右 == true:
		对象内容节点.scale.x = 1
	var 按住_移动左 : bool = Input.is_action_pressed("移动←")
	if 按住_移动左 == true:
		对象内容节点.scale.x = -1

#region 常规接口  用于处理道具的特殊效果
func 接口_生成时() -> void:
	if 66 in 道具持有数据:
		创建动态变量计时器(
			"道具66_触发计时器", 道具静态特殊变量数据库["道具66_触发间隔时间"], 1,
			func():
				动态变量字典["道具66_触发计时器"].start()
				if "子弹数量" in self:
					self.子弹数量 += 道具静态特殊变量数据库["道具66_获得子弹数量"] * 道具持有数据[66]
				)
	if 76 in 道具持有数据:
		if not 全局动态变量字典.has("道具76_增加最大生命值数值统计"):
			全局动态变量字典["道具76_增加最大生命值数值统计"] = 0
		创建动态变量计时器(
			"道具76_触发计时器", 道具静态特殊变量数据库["道具76_触发间隔时间"], 1,
			func():
				动态变量字典["道具76_触发计时器"].start()
				var 随机数 = randf()
				if 随机数 <= 全局数据库.道具静态特殊变量数据库["道具76_触发概率值"]:
					if 生命值 > 道具静态特殊变量数据库["道具76_生命值减少数值"]:
						生命值 -= 道具静态特殊变量数据库["道具76_生命值减少数值"]
						全局方法.修改玩家属性值("玩家属性_最大生命值", 2, 道具静态特殊变量数据库["道具76_增加最大生命值数值"])
						全局动态变量字典["道具76_增加最大生命值数值统计"] += 道具静态特殊变量数据库["道具76_增加最大生命值数值"]
				)
