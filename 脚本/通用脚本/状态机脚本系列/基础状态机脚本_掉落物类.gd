extends 基础状态机脚本

class_name 基础状态机脚本_掉落物类

func 接口_被拾取时() -> void:
	if 58 in 道具持有数据:
		var 该道具持有数量 = 道具持有数据[58]
		var 随机数 = randf()
		if 随机数 <= 全局数据库.道具静态特殊变量数据库["道具54_触发概率值"] * 该道具持有数量:
			对象播放普通音频("特殊音效_效果类4")
			if not 全局动态变量字典.has("道具58_增加生命再生数值统计"):
				全局动态变量字典["道具58_增加生命再生数值统计"] = 0
			全局方法.修改玩家属性值("玩家属性_生命再生", 2, 道具静态特殊变量数据库["道具58_增加生命再生数值"])
			全局动态变量字典["道具58_增加生命再生数值统计"] += 道具静态特殊变量数据库["道具58_增加生命再生数值"]
