extends 基础状态机脚本_可受伤类

class_name 基础状态机脚本_敌人

var 当前游玩角色实例 = null
var 移动速度浮动比例值 : float = 0.2
var 金币数值 : float = 2

func _ready() ->void:
	super()
	当前游玩角色实例 = await 全局方法.等待获取("当前游玩角色实例", 全局数据_系统, 全局方法.玩家角色实例就绪)
	生成时变量同步()
	接口_生成时()

func 结算受伤() -> void:
	super()
	全局方法.屏幕抖动(4, 0.1, true)
	全局方法.修改游戏速度(0.1, 0.2)
	全局方法.生成对象池特效("特效_命中1", 连接点字典["命中特效连接点"].global_position)
	全局方法.生成伤害数值特效(记录接受伤害, 连接点字典["伤害数值特效连接点"].global_position)

func 被击败处理() -> void:
	var 随机数 = randf()
	if 随机数 <= 全局数据_周期波次.当前敌人掉落概率:
		var 生成金币 = 全局方法.生成普通对象_自由版("掉落物_金币", 连接点字典["掉落物生成连接点"].global_position, 全局数据_系统.当前场景实体层实例)
		生成金币.get_node("状态机模块").金币数值 = 金币数值
	接口_被击败时()
	主节点.queue_free()

func 状态改变更新数据(状态名 : String) -> void:
	super(状态名)
	var 随机浮动数 = 1 + randf_range(-移动速度浮动比例值, 移动速度浮动比例值)
	水平加速 *= 随机浮动数
	水平最大移动 *= 随机浮动数
	水平减速 *= 随机浮动数

func 生成时变量同步() -> void:
	var 该敌人编号 = 全局数据库.敌人数据库_对象资源名称次级索引[对象资源名称][0]
	生命值最大 = 全局数据库.敌人数据库[该敌人编号]["生命值最大"]
	生命值最大 *= 全局数据_周期波次.当前敌人生命值倍率
	生命值 = 生命值最大
	金币数值 = 全局数据库.敌人数据库[该敌人编号]["金币数值"]

func 跟随玩家控制方向(是否正向 : bool = true) -> void:
	if not is_instance_valid(当前游玩角色实例):
		if not is_instance_valid(全局数据_系统.当前游玩角色实例):
			return
		当前游玩角色实例 = 全局数据_系统.当前游玩角色实例
	if 当前游玩角色实例.global_position.x > 主节点.global_position.x:
		对象内容节点.scale.x = 1
	else:
		对象内容节点.scale.x = -1
	if 是否正向 == false:
		对象内容节点.scale.x *= -1

func 与玩家角色的距离检测(指定距离 : float = 0, 检测方式 : int = 1) -> bool:
	#1-小于等于指定距离，2-大于等于指定距离
	if 当前游玩角色实例 == null or not is_instance_valid(当前游玩角色实例):
		return false
	var 计算距离 : float = 当前游玩角色实例.global_position.x - 主节点.global_position.x
	if 检测方式 == 1:
		return abs(计算距离) <= 指定距离
	if 检测方式 == 2:
		return abs(计算距离) >= 指定距离
	return false

#region 常规接口  用于处理道具的特殊效果
func 接口_生成时() -> void:
	pass
func 接口_攻击命中时() -> void:
	pass
func 接口_结算受伤时() -> void:
	super()
	if 64 in 道具持有数据:
		var 随机数 = randf()
		if 随机数 <= 道具静态特殊变量数据库["道具64_触发概率值"]:
			var 生成数量 = randi_range(道具静态特殊变量数据库["道具64_掉落硬币数量最小"], 道具静态特殊变量数据库["道具64_掉落硬币数量最大"])
			while 生成数量 > 0:
				var 生成硬币 = 全局方法.生成普通对象_自由版("掉落物_硬币", 连接点字典["掉落物生成连接点"].global_position, 全局数据_系统.当前场景实体层实例)
				生成硬币.get_node("状态机模块").金币数值 = 道具静态特殊变量数据库["道具64_硬币价值"]
				生成数量 -= 1
func 接口_被击败时() -> void:
	if 19 in 道具持有数据:
		var 随机数 = randf()
		if 随机数 <= 道具静态特殊变量数据库["道具19_生成小黄瓜概率值"]:
			全局方法.生成普通对象_自由版("掉落物_小黄瓜", 连接点字典["掉落物生成连接点"].global_position, 全局数据_系统.当前场景实体层实例)
	if 60 in 道具持有数据:
		var 随机数 = randf()
		if 随机数 <= 道具静态特殊变量数据库["道具60_触发概率值"]:
			对象播放普通音频("特殊音效_摇钟")
	if 79 in 道具持有数据:
		var 随机数 = randf()
		if 随机数 <= 道具静态特殊变量数据库["道具79_触发概率值"] * 道具持有数据[79]:
			全局方法.生成普通对象("投射物_雷电爆炸", 连接点字典["掉落物生成连接点"].global_position, 全局数据_系统.当前场景实体层实例, 对象内容节点.scale.x, 全局数据_系统.当前游玩角色状态机模块实例)

func 状态接口_进入移动时() -> void:
	pass
func 状态接口_进行移动时() -> void:
	pass
func 状态接口_进入跳跃时() -> void:
	pass
func 状态接口_进入技能时(状态名 : String) -> void:  #开始技能的第一段动画的一帧执行(比如有的道具根据释放技能次数给效果)
	状态接口_持续技能时(状态名)
	pass
func 状态接口_持续技能时(_状态名 : String) -> void:  #开始技能的每一段动画的一帧执行(道具给技能加伤，但有的技能是分段状态的，开启新的一段后数据全都刷新了，需要再执行一次)
	pass
func 状态接口_进行技能时() -> void:  #技能动画的每一帧执行
	pass
func 状态接口_进入受伤时() -> void:
	pass
#endregion
