extends 基础状态机脚本

class_name 基础状态机脚本_可攻击类

@warning_ignore("unused_signal")
signal 重置攻击区域检测

var 对象资源名称 : String = ""
var 上层状态机模块 : Node
var 初始状态名称 : String = ""
var 指定对象初始状态 : String
var 默认初始状态 : String
var 技能倒计时填充数 : int = 16
var 技能倒计时 : PackedFloat32Array  #不用怀疑，这里用数组，性能确实好一点

#region 技能相关变量
var 当前技能基础伤害 : float = 0
var 当前技能物理伤害 : float = 0
var 当前技能魔法伤害 : float = 0
var 当前技能给予击飞速度 : float = 0
var 当前技能给予击退速度 : float = 0
var 当前技能给予击退时间 : float = 0
var 当前技能给予硬直时间 : float = 0
var 已记录攻击到的受伤区域列表 : Array = []
#进入这个数组的受伤区域不重复处理受伤，该数组通过动画调用方法清理
@export var 当前技能给予无敌时间 : float = 0
#该变量通过动画模块上的时间轴来设定，角色的大部分技能用不到，因为不给予无敌时间
#主要给敌人用，因为玩家受伤后需要有一段时间对所有攻击完全无视
var 当前技能重置攻击时间 : float = 0
var 当前技能重置攻击倒计时 : float = -1
#endregion

var 该对象状态数据库 : Dictionary
var 当前状态名称 : String = ""
var 当前动画已结束 : bool = false

func _ready() ->void:
	super()
	if 上层状态机模块 == null:
		上层状态机模块 = self
	该对象状态数据库 = 全局数据库.状态数据库["状态数据库_" + 对象资源名称]
	技能倒计时.resize(技能倒计时填充数)
	if 指定对象初始状态 != "":
		初始状态名称 = 指定对象初始状态
	else:
		初始状态名称 = 默认初始状态

func _physics_process(步进时间 : float) -> void:
	#倒计时逐帧处理
	var 倒计时总数 : int = 技能倒计时.size()
	var 遍历索引 : int = 0
	while 遍历索引 < 倒计时总数:
		var 当前遍历值 = 技能倒计时[遍历索引]
		if 当前遍历值 > 0.0:
			技能倒计时[遍历索引] = max(当前遍历值 - 步进时间, 0)
		遍历索引 += 1
	if 当前技能重置攻击倒计时 > 0:
		当前技能重置攻击倒计时 = max(0, 当前技能重置攻击倒计时 - 步进时间)
		if 当前技能重置攻击倒计时 == 0:
			重置攻击区域检测.emit()
			当前技能重置攻击倒计时 = 当前技能重置攻击时间

func 检测到受伤区域进入(来源区域 : Area2D) -> void:
	var 来源区域的状态机模块 : Node = 来源区域.状态机模块
	var 获取来源的无敌倒计时 = 来源区域的状态机模块.get("无敌倒计时")
	if 获取来源的无敌倒计时 == null:
		return
	if 获取来源的无敌倒计时 > 0:
		return
	if 已记录攻击到的受伤区域列表.has(来源区域):
		return
	已记录攻击到的受伤区域列表.append(来源区域)
	
	var 构造攻击数据 : Dictionary = {}
	var 获取自身ID = self.get_instance_id()
	if not 来源区域的状态机模块.是否结算受伤:
		来源区域的状态机模块.是否结算受伤 = true
		来源区域的状态机模块.call_deferred("结算受伤")
	
	var 主节点x位置 = 主节点.global_position.x
	var 来源区域主节点x位置 = 来源区域.主节点.global_position.x
	var 受伤对象的方向 = 1 if 来源区域.对象内容节点.scale.x > 0 else -1
	构造攻击数据["基础伤害"] = 当前技能基础伤害
	构造攻击数据["物理伤害"] = 当前技能物理伤害
	构造攻击数据["魔法伤害"] = 当前技能魔法伤害
	构造攻击数据["击飞速度"] = 当前技能给予击飞速度
	构造攻击数据["击退速度"] = (int(来源区域主节点x位置 > 主节点x位置) * 2 - 1) * 当前技能给予击退速度 * 受伤对象的方向
	构造攻击数据["击退时间"] = 当前技能给予击退时间
	构造攻击数据["硬直时间"] = 当前技能给予硬直时间
	构造攻击数据["无敌时间"] = 当前技能给予无敌时间
	来源区域的状态机模块.接受攻击数据字典[获取自身ID] = 构造攻击数据
	接口_攻击命中时()

func 接口_攻击命中时() -> void:  #这里留空，防止报错，敌人和角色一般不可能在这个接口有相同的代码
	pass

func 状态改变更新数据(状态名 : String) -> void:
	#除了被状态机脚本调用以外，还可以用于动画模块，某些动画不同段落的数据不一样，这时候只修改数据不更改状态名
	if not 状态名 in 该对象状态数据库:
		print("【警告！】对象：", 对象资源名称, "，数据库中不存在状态：", 状态名)
		return
	var 状态数据 : Dictionary = 该对象状态数据库[状态名]
	全局方法.将字典赋值给对象(self, 状态数据)
	if 状态数据.get("角色技能伤害计算", "") == "使用":
		角色技能伤害计算()
	if 状态数据.get("敌人技能伤害计算", "") == "使用":
		敌人技能伤害计算()
	
	禁用重置攻击倒计时()

func 启用重置攻击倒计时() -> void:
	当前技能重置攻击倒计时 = 当前技能重置攻击时间
	
func 禁用重置攻击倒计时() -> void:
	当前技能重置攻击倒计时 = -1

func 角色技能伤害计算() -> void:
	var 适用物理攻击 = min(全局数据_周期对局.玩家属性_物理攻击, 全局数据_周期对局.玩家属性_攻击力上限)
	var 适用魔法攻击 = min(全局数据_周期对局.玩家属性_魔法攻击, 全局数据_周期对局.玩家属性_攻击力上限)
	当前技能物理伤害 *= 1 + 适用物理攻击 / 100
	当前技能魔法伤害 *= 1 + 适用魔法攻击 / 100

func 敌人技能伤害计算() -> void:
	当前技能基础伤害 *= 全局数据_周期波次.当前敌人伤害倍率
	当前技能物理伤害 *= 全局数据_周期波次.当前敌人伤害倍率
	当前技能魔法伤害 *= 全局数据_周期波次.当前敌人伤害倍率

func 清空已记录攻击对象列表() -> void:
	已记录攻击到的受伤区域列表 = []

func 对象生成投射物(投射物名称 : String, 指定初始状态 : String = "") -> Node:
	var 生成对象的状态机模块 = 全局方法.生成普通对象(投射物名称, 连接点字典["投射物发射连接点"].global_position, 全局数据_系统.当前场景实体层实例, 对象内容节点.scale.x, 上层状态机模块, 指定初始状态)
	return 生成对象的状态机模块
