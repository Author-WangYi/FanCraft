func 生成敌人对象() -> void:
	var 生成敌人权数 = randf_range(当前敌人刷新总权数最小, 当前敌人刷新总权数最大)
	var 生成位置x = randf_range(生成区域左上点坐标.x, 生成区域右下点坐标.x)
	var 生成位置y = randf_range(生成区域右下点坐标.y, 生成区域左上点坐标.y)
	敌人刷新倒计时 = randf_range(当前敌人刷新间隔最小, 当前敌人刷新间隔最大)
	while 生成敌人权数 > 0:
		var 生成敌人随机数 = randf_range(0, 当前刷新概率数总和_敌人)
		var 随机偏移量x = randf_range(-生成敌人偏移量x, 生成敌人偏移量x)
		var 随机偏移量y = randf_range(-生成敌人偏移量y, 生成敌人偏移量y)
		var 当前生成位置x = min(max((生成位置x + 随机偏移量x), 生成区域左上点坐标.x), 生成区域右下点坐标.x)
		var 当前生成位置y = min(max((生成位置y + 随机偏移量y), 生成区域右下点坐标.y), 生成区域左上点坐标.y)
		for 遍历编号 in range(1, 当前刷新概率数_敌人.size() + 1):
			if 生成敌人随机数 <= 当前刷新概率数_敌人[遍历编号]:
				var 获取敌人资源名称 = 全局数据库.敌人数据库[遍历编号]["对象资源名称"]
				生成敌人权数 -= 全局数据库.敌人数据库[遍历编号]["敌人权数"]
				全局方法.生成普通对象(获取敌人资源名称, Vector2(当前生成位置x, 当前生成位置y), 全局数据_系统.当前场景实体层实例)
				break
			生成敌人随机数 -= 当前刷新概率数_敌人[遍历编号]

func 创建动态变量计时器(计时器名称 : String, 时长 : float, 时长处理方式 : int = 1, 回调函数 : Callable = Callable()):
	var 目标计时器: Timer
	# 1. 仅在不存在时进行“重型”初始化
	if not 动态变量字典.has(计时器名称) or not is_instance_valid(动态变量字典[计时器名称]):
		目标计时器 = Timer.new()
		目标计时器.one_shot = true
		目标计时器.name = 计时器名称
		self.add_child(目标计时器)
		# 仅在此处绑定一次回调，后续重置不再改动逻辑
		if not 回调函数.is_null():
			目标计时器.timeout.connect(回调函数)
		动态变量字典[计时器名称] = 目标计时器
	else:
		目标计时器 = 动态变量字典[计时器名称]
	# 2. 直接启动（如果正在运行，start 会自动重置时间并重新计时）
	match 时长处理方式:
		1:
			目标计时器.start(时长)
		2:
			目标计时器.start(目标计时器.time_left + 时长)

