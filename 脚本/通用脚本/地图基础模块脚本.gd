func _ready() -> void:
	主节点 = self.owner
	地图边界节点 = 主节点.get_node("地图边界节点")
	生成区域边界节点 = 主节点.get_node("生成区域边界节点")
	实体层节点 = 主节点.get_node("实体层")
	摄像机模块 = 主节点.get_node("摄像机模块")
	
	全局数据_系统.当前场景地图基础模块实例 = self
	全局数据_系统.当前场景实体层实例 = 实体层节点
	
	摄像机模块.make_current()
	地图左上点坐标 = 地图边界节点.get_node("地图左上点").global_position
	地图右下点坐标 = 地图边界节点.get_node("地图右下点").global_position
	生成区域左上点坐标 = 生成区域边界节点.get_node("生成区域左上点").global_position
	生成区域右下点坐标 = 生成区域边界节点.get_node("生成区域右下点").global_position
	摄像机模块.limit_left = 地图左上点坐标.x
	摄像机模块.limit_top = 地图左上点坐标.y
	摄像机模块.limit_right = 地图右下点坐标.x
	摄像机模块.limit_bottom = 地图右下点坐标.y
	
	生成时数据同步()
	生成角色对象()
	接口_波次开始时()

func _physics_process(步进时间 : float) -> void:
	if 当前波次倒计时 > 0:
		当前波次倒计时 -= 步进时间
		if 当前波次倒计时 <= 0:
			波次结束处理()
	if 敌人刷新倒计时 > 0:
		敌人刷新倒计时 -= 步进时间
		if 敌人刷新倒计时 <= 0:
			生成敌人对象()
	if 全局数据_周期对局.经验值 >= 全局数据_周期对局.经验值最大:
		升级处理()

func 生成时数据同步() -> void:
	var 当前波次数据 : Dictionary
	if 全局数据库.波次数据库.has(全局数据_周期对局.当前波次):
		当前波次数据 = 全局数据库.波次数据库[全局数据_周期对局.当前波次]
	else:
		var 数据库中最大波次 = 全局数据库.波次数据库.keys().max()
		当前波次数据 = 全局数据库.波次数据库[数据库中最大波次]
	全局数据_周期波次.当前敌人掉落概率 = 当前波次数据["当前敌人掉落概率"]
	当前波次总时间 = 当前波次数据["当前波次总时间"]
	当前波次倒计时 = 当前波次总时间
	当前敌人刷新间隔最小 = 当前波次数据["当前敌人刷新间隔最小"]
	当前敌人刷新间隔最大 = 当前波次数据["当前敌人刷新间隔最大"]
	敌人刷新倒计时 = randf_range(当前敌人刷新间隔最小, 当前敌人刷新间隔最大)
	
	当前敌人刷新总权数最小 = 当前波次数据["当前敌人刷新总权数最小"]
	当前敌人刷新总权数最大 = 当前波次数据["当前敌人刷新总权数最大"]
	当前刷新概率数总和_敌人 = 全局方法.构建概率数字典(当前刷新概率数_敌人, "当前刷新概率数_敌人", 当前波次数据)
	
	全局数据_周期波次.当前敌人生命值倍率 = 1 + (全局数据_周期对局.当前波次 - 1) * 全局数据_环境.每波次敌人生命值倍率变化
	全局数据_周期波次.当前敌人伤害倍率 = 1 + (全局数据_周期对局.当前波次 - 1) * 全局数据_环境.每波次敌人伤害倍率变化
	
	等级数据库 = 全局数据库.等级数据库
	道具持有数据 = 全局数据_周期对局.道具持有数据
	全局动态变量字典 = 全局数据_周期波次.道具动态特殊变量字典
	道具静态特殊变量数据库 = 全局数据库.道具静态特殊变量数据库
	经验值最大数据同步()

func 经验值最大数据同步() -> void:
	var 获取等级数值 = int(全局数据_周期对局.玩家属性_等级)
	if 获取等级数值 in 等级数据库:
		全局数据_周期对局.经验值最大 = 等级数据库[获取等级数值]["经验值最大"]
	else:
		var 数据库中最大等级 = 等级数据库.keys().max()
		全局数据_周期对局.经验值最大 = 等级数据库[数据库中最大等级]["经验值最大"]

func 升级处理() -> void:
	全局数据_周期对局.经验值 -= 全局数据_周期对局.经验值最大
	全局数据_周期波次.记录升级次数 += 1
	全局数据_周期对局.玩家属性_等级 += 1
	经验值最大数据同步()
	接口_玩家升级时()

