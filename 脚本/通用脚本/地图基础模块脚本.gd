func 波次结束处理() -> void:
	全局方法.当前波次已结束.emit()
	var 生成波次通过提示 = 全局数据库.UI资源预加载数据库["UI_波次通过提示文字"].instantiate()
	全局数据_系统.当前场景UI层实例.add_child(生成波次通过提示)
	var 当前角色技能背包类型 = 全局数据库.角色数据库[全局数据_周期对局.当前角色编号]["角色技能背包类型"]
	
	var 收获提供金钱 = 全局数据_周期对局.玩家属性_收获
	var 收获变化值
	if 全局数据_周期对局.玩家属性_收获 >= 0:
		收获变化值 = ceil(全局数据_周期对局.玩家属性_收获 / 2)
	else:
		收获变化值 = floor(全局数据_周期对局.玩家属性_收获 / 2)
	全局方法.修改玩家属性值("金钱数", 2, 收获提供金钱)
	全局方法.修改玩家属性值("玩家属性_收获", 3, 收获变化值)
	
	if 当前角色技能背包类型 in [1, 3]:
		var 已扣减耐久度技能编号 : Array = []
		for 遍历携带技能编号 in 全局数据_周期对局.技能编号_键位:
			if (遍历携带技能编号 == 0 or 
			遍历携带技能编号 in 已扣减耐久度技能编号 or
			全局数据_周期对局.技能持有数据[遍历携带技能编号] == -999):
				continue
			已扣减耐久度技能编号.append(遍历携带技能编号)
			全局数据_周期对局.技能持有数据[遍历携带技能编号] -= 1
			if 全局数据_周期对局.技能持有数据[遍历携带技能编号] == 0:
				for 遍历键位 in range(全局数据_周期对局.技能编号_键位.size()):
					if 全局数据_周期对局.技能编号_键位[遍历键位] == 遍历携带技能编号:
						全局数据_周期对局.技能编号_键位[遍历键位] = 0
	
	全局数据_游玩进度.角色通过最大波次[全局数据_周期对局.当前角色编号] = 全局数据_周期对局.当前波次
	var 遍历角色等级 = 1
	while true:
		if not 遍历角色等级 in 全局数据_环境.角色等级需要通过波次:
			break
		if 全局数据_周期对局.当前波次 < 全局数据_环境.角色等级需要通过波次[遍历角色等级]:
			break
		var 当前角色解锁道具数据 = 全局数据库.角色解锁进度数据库[全局数据_周期对局.当前角色编号]
		if str(遍历角色等级) in 当前角色解锁道具数据:
			var 本次解锁道具编号 = 当前角色解锁道具数据[str(遍历角色等级)]
			全局数据_游玩进度.道具解锁数据[本次解锁道具编号] = true
		遍历角色等级 += 1
	
	接口_波次结束时()

